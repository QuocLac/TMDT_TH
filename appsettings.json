        "FromDistrictId": 0,
        "FromWardCode": "",
        "SenderName": "",
        "SenderPhone": "",
        "SenderAddress": "",
        "WebhookSecret": "",
        "RequiredNote": "KHONGCHOXEMHANG",
        "PaymentTypeId": 1,
        "DefaultServiceTypeId": 2,
        "DefaultWeightGram": 500,
        "DefaultLengthCm": 20,
        "DefaultWidthCm": 15,
        "DefaultHeightCm": 10,
        "WorkerPollSeconds": 10,
