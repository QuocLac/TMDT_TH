@model WebApplication2.Areas.Admin.ViewModels.ProductEditViewModel
@using WebApplication2.Models
@using WebApplication2.Models.Enums
@{
    ViewData["Title"] = "Cập nhật Sản phẩm";
    var activePromotions = ViewBag.ActivePromotions as List<Promotion>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Index" class="btn btn-light border text-dark"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
    <h5 class="mb-0 fw-bold text-dark">Sửa sản phẩm: @Model.Name</h5>
</div>

<div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4">
    <i class="fa-solid fa-circle-info fs-4 me-3 text-info"></i>
    <div>
        <strong>Lưu ý:</strong> Để thay đổi <strong>Giá bán, Tồn kho và Mã SKU</strong> của từng phiên bản màu sắc/kích thước, vui lòng thao tác trực tiếp tại lưới <a asp-action="Index" class="fw-bold text-dark text-decoration-underline">Danh sách Sản phẩm</a> (Cơ chế Edit-in-line).
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentMainImage" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>

    <div class="row">
        <!-- CỘT TRÁI: THÔNG TIN CƠ BẢN & HÌNH ẢNH -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">Thông tin cơ bản</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-dark fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control border-secondary" onkeyup="generateSlug()" />
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label text-dark fw-bold">Đường dẫn SEO <span class="text-danger">*</span></label>
                        <input asp-for="Slug" class="form-control bg-light border-secondary" />
                        <span asp-validation-for="Slug" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-dark fw-bold">Mô tả chi tiết</label>
                        <textarea asp-for="Description" class="form-control border-secondary" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">Quản lý Hình ảnh</h6>
                </div>
                <div class="card-body">
                    <!-- Ảnh Đại Diện -->
                    <div class="row mb-4 align-items-center">
                        <div class="col-md-3 text-center">
                            <label class="form-label text-dark fw-bold d-block">Ảnh đại diện hiện tại</label>
                            <img src="@(string.IsNullOrEmpty(Model.CurrentMainImage) ? "/images/no-image.png" : Model.CurrentMainImage)" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                        </div>
                        <div class="col-md-9">
                            <label asp-for="MainImage" class="form-label text-dark fw-bold">Thay thế ảnh đại diện mới</label>
                            <input asp-for="MainImage" type="file" class="form-control border-secondary" accept="image/*" />
                            <small class="text-muted d-block mt-1">Bỏ trống nếu muốn giữ nguyên ảnh hiện tại.</small>
                            <span asp-validation-for="MainImage" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <hr />

                    <!-- Ảnh Phụ -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold">Bộ sưu tập ảnh hiện tại</label>
                        <div class="d-flex flex-wrap gap-3 mb-3" id="galleryContainer">
                            @if (Model.CurrentGalleryImages != null && Model.CurrentGalleryImages.Any())
                            {
                                foreach (var img in Model.CurrentGalleryImages)
                                {
                                    <div class="position-relative d-inline-block" id="img-@img.Id">
                                        <img src="@img.ImageUrl" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;" />
                                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-100 translate-middle rounded-circle" style="padding: 0.1rem 0.4rem; font-size: 0.7rem;" onclick="deleteGalleryImage(@img.Id)">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Chưa có ảnh phụ nào.</p>
                            }
                        </div>

                        <label asp-for="GalleryImages" class="form-label text-dark fw-bold">Upload thêm ảnh phụ</label>
                        <input asp-for="GalleryImages" type="file" class="form-control border-secondary" accept="image/*" multiple />
                        <small class="text-muted d-block mt-1">Bạn có thể chọn nhiều ảnh cùng lúc.</small>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">Tối ưu SEO (Tùy chọn)</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="MetaTitle" class="form-label text-dark fw-bold">Thẻ tiêu đề (Meta Title)</label>
                        <input asp-for="MetaTitle" class="form-control border-secondary" placeholder="Tối đa 60 ký tự" maxlength="255" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="MetaDescription" class="form-label text-dark fw-bold">Thẻ mô tả (Meta Description)</label>
                        <textarea asp-for="MetaDescription" class="form-control border-secondary" rows="3" placeholder="150 - 160 ký tự"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: PHÂN LOẠI & TRẠNG THÁI -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4 border-start border-4" style="border-color: var(--primary-moss) !important;">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">Phân loại & Trạng thái</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label text-dark fw-bold">Danh mục <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select border-secondary" asp-items="ViewBag.CategoryId">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BrandId" class="form-label text-dark fw-bold">Nhãn hàng</label>
                        <select asp-for="BrandId" class="form-select border-secondary" asp-items="ViewBag.BrandId">
                            <option value="">-- Chọn nhãn hàng --</option>
                        </select>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive">
                        <label class="form-check-label text-dark fw-bold" asp-for="IsActive">Hiển thị sản phẩm</label>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">Chương trình Khuyến mãi (Voucher)</h6>
                </div>
                <div class="card-body">
                    @if (activePromotions != null && activePromotions.Any())
                    {
                        foreach (var promo in activePromotions)
                        {
                            bool isChecked = Model.SelectedPromotionIds != null && Model.SelectedPromotionIds.Contains(promo.Id);
                            <div class="form-check mb-2">
                                <input class="form-check-input border-secondary" type="checkbox" name="SelectedPromotionIds" value="@promo.Id" id="promo_@promo.Id" @(isChecked ? "checked" : "")>
                                <label class="form-check-label text-dark" for="promo_@promo.Id">
                                    @promo.Name (Giảm @promo.DiscountValue @(promo.Unit == DiscountUnit.Percentage ? "%" : "đ"))
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">Không có chương trình khuyến mãi nào đang hoạt động.</small>
                    }
                </div>
            </div>

            <div class="d-grid gap-2 sticky-top" style="top: 20px;">
                <button type="submit" class="btn text-white btn-lg" style="background-color: var(--primary-moss);">
                    <i class="fa-solid fa-floppy-disk me-2"></i>Lưu Thay Đổi
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function generateSlug() {
            let title = document.getElementById('Name').value;
            let slug = title.toLowerCase().replace(/á|à|ả|ạ|ã|ă|ắ|ằ|ẳ|ẵ|ặ|â|ấ|ầ|ẩ|ẫ|ậ/gi, 'a').replace(/é|è|ẻ|ẽ|ẹ|ê|ế|ề|ể|ễ|ệ/gi, 'e').replace(/i|í|ì|ỉ|ĩ|ị/gi, 'i').replace(/ó|ò|ỏ|õ|ọ|ô|ố|ồ|ổ|ỗ|ộ|ơ|ớ|ờ|ở|ỡ|ợ/gi, 'o').replace(/ú|ù|ủ|ũ|ụ|ư|ứ|ừ|ử|ữ|ự/gi, 'u').replace(/ý|ỳ|ỷ|ỹ|ỵ/gi, 'y').replace(/đ/gi, 'd').replace(/\s+/g, '-').replace(/[^a-z0-9\-]/g, '');
            document.getElementById('Slug').value = slug;
        }

        // Logic xóa ảnh phụ mượt mà bằng AJAX không cần tải lại trang
        function deleteGalleryImage(id) {
            if (confirm('Bạn có chắc chắn muốn xóa ảnh này không?')) {
                fetch(`/Admin/Products/DeleteProductImage?imageId=${id}`, {
                    method: 'POST'
                })
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        // Làm mờ rồi xóa thẻ img đi để tạo hiệu ứng mượt
                        let imgElement = document.getElementById(`img-${id}`);
                        imgElement.style.opacity = '0';
                        setTimeout(() => imgElement.remove(), 300);
                    } else {
                        alert(result.message);
                    }
                })
                .catch(err => alert("Lỗi khi kết nối đến máy chủ!"));
            }
        }
    </script>
}