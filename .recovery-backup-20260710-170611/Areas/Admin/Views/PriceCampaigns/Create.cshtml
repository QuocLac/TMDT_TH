@{
    ViewData["Title"] = ViewBag.CampaignId > 0 ? "Chỉnh sửa Chiến dịch" : "Tạo Chiến dịch Mới";
}

<style>
    .table-container {
        max-height: 550px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
    }

        .table-container thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 1;
            border-bottom: 2px solid #dee2e6;
        }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--primary-moss);
        padding-bottom: 8px;
        margin-bottom: 15px;
    }
</style>

<!-- LƯU TRỮ ID ĐỂ SPA PHÂN BIỆT THÊM MỚI (0) HAY CHỈNH SỬA (>0) -->
<input type="hidden" id="CampaignId" value="@ViewBag.CampaignId" />

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="section-title">THÔNG TIN CHIẾN DỊCH</div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Tên chiến dịch <span class="text-danger">*</span></label>
                        <input type="text" id="CampaignName" class="form-control" placeholder="Nhập tên chiến dịch..." required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="StartDate" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="EndDate" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Mô tả thêm</label>
                        <input type="text" id="CampaignDesc" class="form-control" placeholder="Tùy chọn..." />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- DANH SÁCH 1: NGUỒN SẢN PHẨM -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-body">
                <div class="section-title">TẤT CẢ SẢN PHẨM</div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <input type="text" id="FilterKeyword" class="form-control form-control-sm" placeholder="Mã SKU, Tên SP..." onkeypress="handleEnter(event)">
                    </div>
                    <div class="col-md-3">
                        <select id="FilterCategory" class="form-select form-select-sm" asp-items="@(new SelectList(ViewBag.Categories ?? new List<WebApplication2.Models.Category>(), "Id", "Name"))">
                            <option value="">- Danh mục -</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select id="FilterBrand" class="form-select form-select-sm" asp-items="@(new SelectList(ViewBag.Brands ?? new List<WebApplication2.Models.Brand>(), "Id", "Name"))">
                            <option value="">- Nhãn hàng -</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="fetchProducts()">Tìm kiếm</button>
                    </div>
                </div>

                <div class="table-container">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th width="5%" class="text-center"><input type="checkbox" class="form-check-input" id="checkAllSource" onchange="toggleAllSource(this)"></th>
                                <th width="65%">Mã SKU / Sản phẩm</th>
                                <th width="30%" class="text-end">Giá bán</th>
                            </tr>
                        </thead>
                        <tbody id="sourceGrid">
                            <tr><td colspan="3" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-end">
                    <button type="button" class="btn text-white" style="background-color: var(--primary-moss);" onclick="addSelectedToCampaign()">
                        Thêm vào danh sách áp dụng &rarr;
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH 2: DANH SÁCH ÁP DỤNG -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4 h-100 bg-light">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-end mb-3">
                    <div class="section-title mb-0">DANH SÁCH ÁP DỤNG (<span id="targetCount">0</span>)</div>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeAllFromCampaign()">Xóa tất cả</button>
                </div>

                <div class="row g-2 mb-3 align-items-center p-2 bg-white border rounded">
                    <div class="col-md-4 fw-bold text-dark" style="font-size: 0.9rem;">Cấu hình hàng loạt:</div>
                    <div class="col-md-3">
                        <select id="BulkActionType" class="form-select form-select-sm">
                            <option value="fixed">Set giá cố định</option>
                            <option value="percent">Giảm %</option>
                            <option value="amount">Giảm tiền (đ)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="BulkActionValue" class="form-control form-control-sm" placeholder="Nhập giá trị..." />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-dark btn-sm" onclick="applyBulkAction()">Áp dụng</button>
                    </div>
                </div>

                <div class="table-container bg-white">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th width="35%">Mã SKU</th>
                                <th width="25%" class="text-end">Giá gốc</th>
                                <th width="35%">Giá mới</th>
                                <th width="5%" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody id="targetGrid">
                            <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có sản phẩm nào được chọn.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-12 text-end">
        <a asp-action="Index" class="btn btn-light border px-4 me-2">Hủy bỏ</a>
        <button type="button" class="btn text-white px-5" style="background-color: var(--primary-moss);" onclick="saveCampaign()">LƯU CHIẾN DỊCH</button>
    </div>
</div>

@section Scripts {
    <script>
        let rawSearchData = [];
        let selectedVariants = new Map();

        document.addEventListener("DOMContentLoaded", function () {
            // Khởi chạy lấy lưới sản phẩm ngay khi vào trang
            fetchProducts();

            // KIỂM TRA CHẾ ĐỘ EDIT: Nếu có CampaignId thì tải dữ liệu cũ lên
            const campId = document.getElementById('CampaignId').value;
            if (campId > 0) {
                loadExistingCampaign(campId);
            }
        });

        // =====================================
        // LOGIC CHẾ ĐỘ CHỈNH SỬA (EDIT MODE)
        // =====================================
        function loadExistingCampaign(id) {
            fetch(`/Admin/PriceCampaigns/GetCampaign/${id}`)
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    const c = result.data;

                    // Điền dữ liệu Form
                    document.getElementById('CampaignName').value = c.name;
                    document.getElementById('CampaignDesc').value = c.description;
                    document.getElementById('StartDate').value = c.startDate;
                    document.getElementById('EndDate').value = c.endDate;

                    // Mồi dữ liệu Lưới Đích
                    c.items.forEach(item => {
                        selectedVariants.set(item.variantId, {
                            id: item.variantId,
                            sku: item.sku,
                            name: item.name,
                            attributes: item.attributes,
                            currentPrice: item.currentPrice,
                            newPrice: item.newPrice
                        });
                    });

                    // Vẽ lại 2 lưới
                    renderTargetGrid();
                    renderSourceGrid();
                }
            });
        }

        // =====================================
        // LOGIC TÌM KIẾM & LƯỚI
        // =====================================
        function handleEnter(e) { if (e.key === 'Enter') fetchProducts(); }

        function fetchProducts() {
            const keyword = document.getElementById('FilterKeyword').value;
            const categoryId = document.getElementById('FilterCategory').value;
            const brandId = document.getElementById('FilterBrand').value;

            document.getElementById('sourceGrid').innerHTML = '<tr><td colspan="3" class="text-center py-3">Đang tải dữ liệu...</td></tr>';

            fetch(`/Admin/PriceCampaigns/GetProducts?keyword=${keyword}&categoryId=${categoryId}&brandId=${brandId}`)
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        rawSearchData = result.data;
                        renderSourceGrid();
                    }
                });
        }

        function renderSourceGrid() {
            const tbody = document.getElementById('sourceGrid');
            tbody.innerHTML = '';
            document.getElementById('checkAllSource').checked = false;
            let hasRows = false;

            rawSearchData.forEach(p => {
                let availableVariants = p.variants.filter(v => !selectedVariants.has(v.id));
                if (availableVariants.length > 0) {
                    hasRows = true;
                    tbody.insertAdjacentHTML('beforeend', `
                        <tr class="table-light text-dark fw-bold">
                            <td class="text-center"><input type="checkbox" class="form-check-input parent-cb" data-product-id="${p.id}" onchange="toggleParentCb(this, ${p.id})"></td>
                            <td colspan="2">${p.name} <span class="badge border ms-1 fw-normal text-muted">${p.brand}</span></td>
                        </tr>
                    `);

                    availableVariants.forEach(v => {
                        tbody.insertAdjacentHTML('beforeend', `
                            <tr>
                                <td class="text-center"><input type="checkbox" class="form-check-input child-cb product-${p.id}" value="${v.id}"></td>
                                <td><span class="fw-bold text-dark">${v.sku}</span><br/><small class="text-muted">${v.attributes}</small></td>
                                <td class="text-end fw-semibold text-muted">${v.currentPrice.toLocaleString('vi-VN')} đ</td>
                            </tr>
                        `);
                    });
                }
            });

            if (!hasRows) tbody.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-muted">Không tìm thấy sản phẩm, hoặc tất cả đã được thêm.</td></tr>';
        }

        function toggleAllSource(master) { document.querySelectorAll('.parent-cb, .child-cb').forEach(cb => cb.checked = master.checked); }
        function toggleParentCb(parent, productId) { document.querySelectorAll(`.product-${productId}`).forEach(cb => cb.checked = parent.checked); }

        function addSelectedToCampaign() {
            const checkedBoxes = document.querySelectorAll('.child-cb:checked');
            if (checkedBoxes.length === 0) return;

            checkedBoxes.forEach(cb => {
                const vId = parseInt(cb.value);
                rawSearchData.forEach(p => {
                    let variant = p.variants.find(v => v.id === vId);
                    if (variant) {
                        selectedVariants.set(vId, {
                            id: variant.id,
                            sku: variant.sku,
                            name: p.name,
                            attributes: variant.attributes,
                            currentPrice: variant.currentPrice,
                            newPrice: variant.currentPrice
                        });
                    }
                });
            });

            renderSourceGrid();
            renderTargetGrid();
        }

        function renderTargetGrid() {
            const tbody = document.getElementById('targetGrid');
            tbody.innerHTML = '';
            document.getElementById('targetCount').innerText = selectedVariants.size;

            if (selectedVariants.size === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">Chưa có sản phẩm nào được chọn.</td></tr>';
                return;
            }

            selectedVariants.forEach(v => {
                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">${v.sku}</div>
                            <div class="text-muted" style="font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;" title="${v.name}">${v.name}</div>
                        </td>
                        <td class="text-end text-muted align-middle">${v.currentPrice.toLocaleString('vi-VN')} đ</td>
                        <td class="align-middle">
                            <input type="number" class="form-control form-control-sm border-dark fw-bold text-danger input-new-price"
                                   data-id="${v.id}" value="${v.newPrice}" onchange="updateSinglePrice(${v.id}, this.value)">
                        </td>
                        <td class="text-center align-middle">
                            <button type="button" class="btn btn-sm btn-light text-danger fw-bold border" onclick="removeFromCampaign(${v.id})">X</button>
                        </td>
                    </tr>
                `);
            });
        }

        function removeFromCampaign(vId) { selectedVariants.delete(vId); renderSourceGrid(); renderTargetGrid(); }
        function removeAllFromCampaign() { selectedVariants.clear(); renderSourceGrid(); renderTargetGrid(); }
        function updateSinglePrice(vId, val) { let item = selectedVariants.get(vId); if (item) { item.newPrice = parseFloat(val) || 0; } }

        function applyBulkAction() {
            const type = document.getElementById('BulkActionType').value;
            const val = parseFloat(document.getElementById('BulkActionValue').value || 0);

            if (val <= 0) { alert("Vui lòng nhập giá trị lớn hơn 0"); return; }

            selectedVariants.forEach(item => {
                let p = item.currentPrice;
                if (type === 'fixed') item.newPrice = val;
                else if (type === 'amount') item.newPrice = p - val;
                else if (type === 'percent') item.newPrice = p - (p * (val / 100));
                if (item.newPrice < 0) item.newPrice = 0;
            });

            renderTargetGrid();
        }

        // =====================================
        // LƯU DỮ LIỆU JSON
        // =====================================
        function saveCampaign() {
            const id = document.getElementById('CampaignId').value;
            const name = document.getElementById('CampaignName').value;
            const desc = document.getElementById('CampaignDesc').value;
            const start = document.getElementById('StartDate').value;
            const end = document.getElementById('EndDate').value;

            if (!name || !start || !end) {
                alert("Vui lòng nhập đầy đủ Tên, Ngày bắt đầu và Ngày kết thúc!");
                return;
            }

            if (selectedVariants.size === 0) {
                alert("Vui lòng chọn ít nhất 1 sản phẩm để áp dụng giá!");
                return;
            }

            const items = [];
            let hasError = false;

            selectedVariants.forEach(v => {
                if (!v.newPrice || v.newPrice <= 0) hasError = true;
                items.push({ VariantId: v.id, NewPrice: v.newPrice });
            });

            if (hasError) {
                alert("Một số sản phẩm chưa có giá mới hợp lệ. Vui lòng kiểm tra lại!");
                return;
            }

            const payload = {
                Id: id,
                Name: name,
                Description: desc,
                StartDate: start,
                EndDate: end,
                Items: items
            };

            fetch('/Admin/PriceCampaigns/SaveCampaign', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    window.location.href = '/Admin/PriceCampaigns';
                } else {
                    alert(result.message);
                }
            })
            .catch(err => alert("Lỗi kết nối đến máy chủ."));
        }
        // 8. TỰ ĐỘNG TẢI DỮ LIỆU NGAY KHI MỞ TRANG
        document.addEventListener("DOMContentLoaded", function () {
            fetchProducts();
        });
    </script>
}