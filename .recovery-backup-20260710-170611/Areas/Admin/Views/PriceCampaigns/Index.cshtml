@model IEnumerable<WebApplication2.Models.PriceCampaign>
@{
    ViewData["Title"] = "Quản lý Chiến dịch Giá";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 text-dark fw-bold">Danh sách Chiến dịch Giá</h5>
        <a asp-action="Create" class="btn btn-sm text-white" style="background-color: var(--primary-moss);">
            Tạo chiến dịch mới
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-dark">
                <tr>
                    <th width="30%">Tên chiến dịch</th>
                    <th width="20%">Thời gian bắt đầu</th>
                    <th width="20%">Thời gian kết thúc</th>
                    <th width="15%" class="text-center">Trạng thái</th>
                    <th width="15%" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td>@item.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.EndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                @if (item.EndDate < DateTime.UtcNow)
                                {
                                    <span class="badge bg-secondary">Đã kết thúc</span>
                                }
                                else if (item.StartDate > DateTime.UtcNow)
                                {
                                    <span class="badge border border-warning text-dark">Sắp diễn ra</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Đang diễn ra</span>
                                }
                            </td>
                            <td class="text-center">
                                <!-- NÚT DÙNG NGAY: Chỉ hiện khi đợt sale đã cũ hoặc chưa chạy -->
                                @if (item.EndDate < DateTime.UtcNow || item.StartDate > DateTime.UtcNow)
                                {
                                    <button type="button" class="btn btn-sm btn-light border text-success fw-bold me-1" onclick="applyNow(@item.Id)" title="Kích hoạt dùng ngay">
                                        Dùng ngay
                                    </button>
                                }
                                <!-- Sửa Action thành Create để dùng chung SPA View -->
                                <a asp-action="Create" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-dark" title="Sửa chiến dịch">
                                    Sửa
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-5 text-muted">Chưa có chiến dịch giá nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function applyNow(id) {
            if (confirm('Bạn có muốn kích hoạt chiến dịch này chạy ngay lập tức không? (Hệ thống sẽ tự động gia hạn nếu chiến dịch đã cũ)')) {
                fetch(`/Admin/PriceCampaigns/ApplyNow/${id}`, { method: 'POST' })
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        window.location.reload();
                    } else {
                        alert(result.message);
                    }
                });
            }
        }
    </script>
}