@model WebApplication2.ViewModels.Shared.ErrorPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="store-container error-page" aria-labelledby="error-title">
    <p class="error-page__code">@Model.StatusCode</p>
    <h1 id="error-title">@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="app-button app-button--primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
    @if (!string.IsNullOrWhiteSpace(Model.RequestId))
    {
        <small>Mã tra cứu: <code>@Model.RequestId</code></small>
    }
</section>
