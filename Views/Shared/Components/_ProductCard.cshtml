@using System.Globalization
@model WebApplication2.ViewModels.Storefront.Home.ProductCardViewModel
@{
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl;
    var productUrl = $"/products/{Uri.EscapeDataString(Model.Slug)}";
}

<article class="product-card">
    <a href="@productUrl" class="product-card__link" aria-label="Xem sản phẩm @Model.Name">
        <div class="product-card__media">
            <img src="@imageUrl"
                 alt="@Model.Name"
                 width="320"
                 height="320"
                 loading="lazy"
                 decoding="async" />
            @if (Model.IsOnSale && Model.DiscountPercentage > 0)
            {
                <span class="product-card__discount">Giảm @Model.DiscountPercentage.ToString("0")%</span>
            }
        </div>

        <div class="product-card__body">
            <h3 class="product-card__name">@Model.Name</h3>
            <div class="product-card__pricing">
                @if (Model.IsOnSale && Model.OriginalPrice > Model.EffectivePrice)
                {
                    <span class="product-card__original-price">@Model.OriginalPrice.ToString("N0", culture) ₫</span>
                }
                <strong class="product-card__effective-price">@Model.EffectivePrice.ToString("N0", culture) ₫</strong>
            </div>
            <span class="product-card__stock @(Model.StockQuantity > 0 ? "is-available" : "is-unavailable")">
                @(Model.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")
            </span>
        </div>
    </a>
</article>
