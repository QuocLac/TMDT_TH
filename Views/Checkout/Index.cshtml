@using System.Globalization
@using WebApplication2.Services.Commerce.Orders
@model WebApplication2.ViewModels.Storefront.Checkout.CheckoutPageViewModel
@{
    ViewData["Title"] = "Đặt hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="checkout-page shell-container" data-checkout-page
         data-initial-province="@Model.Form.ProvinceId"
         data-initial-district="@Model.Form.DistrictId"
         data-initial-ward="@Model.Form.WardCode">
    <header class="checkout-hero" data-reveal>
        <div>
            <span class="hero-pill"><i aria-hidden="true"></i>Thanh toán an toàn</span>
            <h1>Xác nhận đơn hàng</h1>
            <p>Giá, tồn kho, địa chỉ và tổng tiền sẽ được hệ thống kiểm tra lại trước khi tạo đơn.</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="button button--glass">Quay lại giỏ hàng</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="checkout-alert checkout-alert--danger checkout-page-error" role="alert">
            <strong>Chưa thể đặt hàng.</strong>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form id="checkout-order-form" asp-controller="Checkout" asp-action="PlaceOrder" method="post"
          data-checkout-form novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ClientRequestId" value="@Model.ClientRequestId" />
        <input type="hidden" name="CartVersion" value="@Model.CartVersion" />

        @for (var index = 0; index < Model.Items.Count; index++)
        {
            <input type="hidden" name="Items[@index].VariantId" value="@Model.Items[index].VariantId" />
            <input type="hidden" name="Items[@index].Quantity" value="@Model.Items[index].Quantity" />
            <input type="hidden" name="Items[@index].ExpectedUnitPrice"
                   value="@Model.Items[index].UnitPrice.ToString(CultureInfo.InvariantCulture)" />
        }

        <div class="checkout-layout" data-reveal>
            <div class="checkout-main-column">
                <section class="checkout-card checkout-address-card" aria-labelledby="checkout-recipient-heading">
                    <div class="checkout-card__heading">
                        <div>
                            <p class="eyebrow">Thông tin người nhận</p>
                            <h2 id="checkout-recipient-heading">Liên hệ giao hàng</h2>
                        </div>
                        <span class="checkout-provider-badge"><i aria-hidden="true"></i>Server verified</span>
                    </div>

                    <div class="checkout-form-grid">
                        <label class="checkout-field checkout-field--wide">
                            <span>Họ và tên <b>*</b></span>
                            <input name="FullName" maxlength="100" minlength="2" required
                                   value="@Model.Form.FullName" autocomplete="name" />
                        </label>

                        <label class="checkout-field">
                            <span>Email <b>*</b></span>
                            <input type="email" name="Email" maxlength="150" required
                                   value="@Model.Form.Email" autocomplete="email" />
                        </label>

                        <label class="checkout-field">
                            <span>Số điện thoại <b>*</b></span>
                            <input type="tel" name="Phone" maxlength="15" minlength="9" required
                                   value="@Model.Form.Phone" autocomplete="tel" inputmode="numeric" />
                        </label>
                    </div>
                </section>

                <section class="checkout-card checkout-address-card" aria-labelledby="checkout-address-heading">
                    <div class="checkout-card__heading">
                        <div>
                            <p class="eyebrow">Địa chỉ nhận hàng</p>
                            <h2 id="checkout-address-heading">Chọn theo dữ liệu GHN</h2>
                        </div>
                        <span class="checkout-provider-badge"><i aria-hidden="true"></i>GHN address</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AddressLookupError))
                    {
                        <div class="checkout-alert checkout-alert--warning" role="alert">
                            @Model.AddressLookupError
                            <small>Cần cấu hình GHN trên server để xác minh và đặt hàng.</small>
                        </div>
                    }

                    <div class="checkout-form-grid">
                        <label class="checkout-field checkout-field--wide">
                            <span>Địa chỉ cụ thể <b>*</b></span>
                            <input name="AddressLine" maxlength="200" minlength="3" required
                                   value="@Model.Form.AddressLine"
                                   placeholder="Số nhà, tên đường, tòa nhà..." autocomplete="street-address" />
                        </label>

                        <label class="checkout-field checkout-field--wide">
                            <span>Tỉnh/thành phố <b>*</b></span>
                            <select name="ProvinceId" required data-province-select
                                    @(Model.Provinces.Count == 0 ? "disabled" : null)>
                                <option value="">Chọn tỉnh/thành phố</option>
                                @foreach (var province in Model.Provinces)
                                {
                                    <option value="@province.ProvinceId"
                                            selected="@(province.ProvinceId == Model.Form.ProvinceId)">
                                        @province.ProvinceName
                                    </option>
                                }
                            </select>
                        </label>

                        <label class="checkout-field">
                            <span>Quận/huyện <b>*</b></span>
                            <select name="DistrictId" required data-district-select disabled>
                                <option value="">Chọn quận/huyện</option>
                            </select>
                        </label>

                        <label class="checkout-field">
                            <span>Phường/xã <b>*</b></span>
                            <select name="WardCode" required data-ward-select disabled>
                                <option value="">Chọn phường/xã</option>
                            </select>
                        </label>
                    </div>

                    <div class="checkout-address-actions">
                        <button type="button" class="button button--secondary" data-validate-address>
                            Kiểm tra địa chỉ
                        </button>
                        <span class="checkout-validation-state" data-address-validation-state role="status">
                            Chưa kiểm tra
                        </span>
                    </div>
                    <div class="checkout-alert" data-checkout-message role="status" hidden></div>

                    <div class="checkout-canonical-address" data-canonical-address hidden>
                        <span class="checkout-canonical-address__icon" aria-hidden="true">✓</span>
                        <div>
                            <strong data-canonical-address-text></strong>
                            <small>Server vẫn xác minh lại địa chỉ khi tạo đơn.</small>
                        </div>
                    </div>
                </section>

                <section class="checkout-card checkout-payment-card" aria-labelledby="checkout-payment-heading">
                    <div class="checkout-card__heading">
                        <div>
                            <p class="eyebrow">Phương thức thanh toán</p>
                            <h2 id="checkout-payment-heading">Chọn cách thanh toán</h2>
                        </div>
                    </div>

                    <div class="checkout-payment-options">
                        <label class="checkout-payment-option">
                            <input type="radio" name="PaymentMethod"
                                   value="@OrderApplicationService.CodPaymentMethod"
                                   checked="@(Model.Form.PaymentMethod != OrderApplicationService.MockOnlinePaymentMethod)" />
                            <span>
                                <strong>Thanh toán khi nhận hàng</strong>
                                <small>Thanh toán cho đơn vị vận chuyển khi giao thành công.</small>
                            </span>
                        </label>

                        <label class="checkout-payment-option">
                            <input type="radio" name="PaymentMethod"
                                   value="@OrderApplicationService.MockOnlinePaymentMethod"
                                   checked="@(Model.Form.PaymentMethod == OrderApplicationService.MockOnlinePaymentMethod)" />
                            <span>
                                <strong>Thanh toán trực tuyến</strong>
                                <small>Adapter thử nghiệm trước khi tích hợp VNPay Sandbox.</small>
                            </span>
                        </label>
                    </div>

                    <label class="checkout-field checkout-mock-outcome" data-online-outcome>
                        <span>Kết quả giao dịch trong môi trường phát triển</span>
                        <select name="MockPaymentOutcome">
                            <option value="@OrderApplicationService.MockSuccessOutcome"
                                    selected="@(Model.Form.MockPaymentOutcome != OrderApplicationService.MockFailureOutcome)">
                                Thành công
                            </option>
                            <option value="@OrderApplicationService.MockFailureOutcome"
                                    selected="@(Model.Form.MockPaymentOutcome == OrderApplicationService.MockFailureOutcome)">
                                Thất bại
                            </option>
                        </select>
                    </label>
                </section>
            </div>

            <aside class="checkout-card checkout-summary-card" aria-labelledby="checkout-summary-heading">
                <div class="checkout-card__heading">
                    <div>
                        <p class="eyebrow">Tóm tắt đơn hàng</p>
                        <h2 id="checkout-summary-heading">@Model.Items.Count dòng sản phẩm</h2>
                    </div>
                    <span class="checkout-summary-card__step">FINAL</span>
                </div>

                <div class="checkout-items">
                    @foreach (var item in Model.Items)
                    {
                        <article class="checkout-item">
                            <img src="@item.ImageUrl" alt="@item.ProductName" width="64" height="64" loading="lazy" />
                            <div>
                                <strong>@item.ProductName</strong>
                                <span>@item.VariantDescription · SL @item.Quantity</span>
                            </div>
                            <b>@item.LineTotal.ToString("N0", culture) ₫</b>
                        </article>
                    }
                </div>

                <dl class="checkout-totals">
                    <div><dt>Tạm tính</dt><dd>@Model.Subtotal.ToString("N0", culture) ₫</dd></div>
                    <div><dt>Phí vận chuyển</dt><dd>@Model.ShippingFee.ToString("N0", culture) ₫</dd></div>
                    <div class="checkout-totals__grand">
                        <dt>Tổng thanh toán</dt>
                        <dd>@Model.GrandTotal.ToString("N0", culture) ₫</dd>
                    </div>
                </dl>

                <button type="submit" class="button button--primary checkout-submit"
                        data-place-order @(Model.Provinces.Count == 0 ? "disabled" : null)>
                    Đặt hàng
                </button>

                <div class="checkout-next-step">
                    <span class="checkout-next-step__dot" aria-hidden="true"></span>
                    <p><strong>Không tin dữ liệu từ trình duyệt.</strong> Hệ thống sẽ tải lại giá, tồn kho và tính lại tổng tiền trong transaction.</p>
                </div>
            </aside>
        </div>
    </form>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/storefront/checkout.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/storefront/checkout-address.js" asp-append-version="true"></script>
}
