@using System.Globalization
@model WebApplication2.ViewModels.Storefront.Returns.ReturnConfirmationViewModel
@{
    ViewData["Title"] = $"Hoàn trả {Model.ReturnCode}";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="return-page shell-container">
    <header class="return-hero is-confirmed">
        <p class="eyebrow">Return @Model.ReturnCode</p>
        <h1>Yêu cầu đã được ghi nhận</h1>
        <p>
            Trạng thái hiện tại: <strong>@Model.Status</strong>.
            Mỗi bước duyệt, vận chuyển về kho, kiểm định và hoàn tiền được theo dõi độc lập.
        </p>
        <div class="checkout-success-actions">
            <a asp-controller="Checkout" asp-action="Success"
               asp-route-publicToken="@Model.OrderPublicToken"
               class="button button--primary">Mở đơn @Model.OrderCode</a>
            <a asp-controller="Home" asp-action="Index"
               class="button button--glass">Tiếp tục mua sắm</a>
        </div>
    </header>

    <div class="return-confirmation-grid">
        <section class="return-card">
            <p class="eyebrow">Sản phẩm hoàn trả</p>
            <div class="return-confirmation-lines">
                @foreach (var item in Model.Items)
                {
                    <article>
                        <div>
                            <strong>@item.ProductName</strong>
                            <span>@item.VariantDescription · @item.Sku</span>
                        </div>
                        <dl>
                            <div><dt>Yêu cầu</dt><dd>@item.RequestedQuantity</dd></div>
                            <div><dt>Được duyệt</dt><dd>@item.ApprovedQuantity</dd></div>
                            <div><dt>Kho đã nhận</dt><dd>@item.ReceivedQuantity</dd></div>
                            <div><dt>Dự kiến hoàn</dt><dd>@item.RefundAmount.ToString("N0", culture) ₫</dd></div>
                        </dl>
                    </article>
                }
            </div>
        </section>

        <aside class="return-card">
            <p class="eyebrow">Thông tin xử lý</p>
            <dl class="return-summary">
                <div><dt>Đơn hàng</dt><dd>@Model.OrderCode</dd></div>
                <div><dt>Lý do</dt><dd>@Model.ReasonCode</dd></div>
                <div><dt>Mô tả</dt><dd>@Model.ReasonText</dd></div>
                <div><dt>Gửi lúc</dt><dd>@Model.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div><dt>Hạn return</dt><dd>@Model.ReturnWindowExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                <div><dt>Tracking chiều về</dt><dd>@(Model.TrackingCode ?? "Chưa tạo")</dd></div>
            </dl>
        </aside>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/storefront/returns.css" asp-append-version="true" />
}
