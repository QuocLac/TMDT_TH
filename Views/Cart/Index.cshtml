@using System.Globalization
@model WebApplication2.ViewModels.Storefront.Cart.CartPageViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="cart-page shell-container" data-cart-page>
    <header class="cart-masthead" data-reveal>
        <div class="cart-masthead__content">
            <span class="hero-pill">
                <i aria-hidden="true"></i>
                Giỏ hàng mua sắm
            </span>
            <h1>Giỏ hàng của bạn</h1>
            <p>
                Kiểm tra sản phẩm, biến thể và số lượng trước khi chuyển sang
                bước giao hàng và thanh toán.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="products"
           class="button button--glass">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Tiếp tục mua sắm
        </a>

        <span class="cart-masthead__orb" aria-hidden="true"></span>
    </header>

    <ol class="cart-steps" aria-label="Tiến trình mua hàng" data-reveal>
        <li class="is-active">
            <span>1</span>
            <strong>Giỏ hàng</strong>
        </li>
        <li>
            <span>2</span>
            <strong>Thanh toán</strong>
        </li>
        <li>
            <span>3</span>
            <strong>Hoàn tất</strong>
        </li>
    </ol>

    <div class="cart-page__notice" role="note" data-reveal>
        <span class="cart-page__notice-icon" aria-hidden="true">
            <i class="fa-solid fa-rotate"></i>
        </span>
        <div>
            <strong>Giá và tồn kho được cập nhật tự động</strong>
            <p>
                FastBuy đối chiếu lại giá bán và số lượng khả dụng khi bạn thay
                đổi giỏ hàng và trước khi ghi nhận đơn.
            </p>
        </div>
    </div>

    @if (Model.IsEmpty)
    {
        <section class="empty-state cart-empty"
                 data-cart-empty
                 data-reveal>
            <span class="empty-state__icon" aria-hidden="true">
                <i class="fa-solid fa-cart-shopping"></i>
            </span>
            <h2>Giỏ hàng đang trống</h2>
            <p>
                Khám phá các ngành hàng và thêm sản phẩm phù hợp để bắt đầu mua sắm.
            </p>
            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="products"
               class="button button--primary">
                Khám phá sản phẩm
            </a>
        </section>
    }
    else
    {
        <div class="cart-layout" data-cart-content>
            <section class="cart-lines"
                     aria-labelledby="cart-lines-heading"
                     data-reveal>
                <header class="cart-lines__toolbar">
                    <label class="cart-select-all">
                        <input type="checkbox"
                               data-cart-select-all
                               checked="@(Model.AllAvailableSelected ? "checked" : null)" />
                        <span class="custom-check" aria-hidden="true"></span>
                        <span>Chọn tất cả sản phẩm còn hàng</span>
                    </label>

                    <span class="cart-lines__count">
                        <strong data-cart-line-count>
                            @Model.TotalLineCount
                        </strong>
                        dòng ·
                        <strong data-cart-total-quantity>
                            @Model.TotalQuantity
                        </strong>
                        sản phẩm
                    </span>
                </header>

                <h2 id="cart-lines-heading" class="visually-hidden">
                    Danh sách sản phẩm trong giỏ
                </h2>

                <div class="cart-lines__list">
                    @foreach (var item in Model.Items)
                    {
                        <article class="cart-line @(!item.CanSelect ? "has-issue" : null)"
                                 data-cart-line
                                 data-variant-id="@item.VariantId"
                                 data-unit-price="@item.EffectivePrice.ToString(CultureInfo.InvariantCulture)">
                            <div class="cart-line__select">
                                <label>
                                    <input type="checkbox"
                                           aria-label="Chọn @item.ProductName - @item.VariantDescription"
                                           data-cart-line-select
                                           checked="@(item.IsSelected ? "checked" : null)"
                                           disabled="@(!item.CanSelect ? "disabled" : null)" />
                                    <span class="custom-check" aria-hidden="true"></span>
                                </label>
                            </div>

                            <a href="/products/@Uri.EscapeDataString(item.ProductSlug)"
                               class="cart-line__media"
                               tabindex="-1">
                                <span class="cart-line__media-grid"
                                      aria-hidden="true"></span>
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName"
                                     width="160"
                                     height="160"
                                     loading="lazy"
                                     data-progressive-image />
                            </a>

                            <div class="cart-line__identity">
                                <a href="/products/@Uri.EscapeDataString(item.ProductSlug)"
                                   class="cart-line__name">
                                    @item.ProductName
                                </a>
                                <span class="cart-line__variant">
                                    @item.VariantDescription
                                </span>
                                <span class="cart-line__sku">
                                    SKU: @item.Sku
                                </span>

                                @if (item.PriceChanged)
                                {
                                    <span class="cart-line__price-change">
                                        Giá đã được cập nhật theo mức bán hiện tại.
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.IssueMessage))
                                {
                                    <span class="cart-line__issue" role="alert">
                                        @item.IssueMessage
                                    </span>
                                }
                            </div>

                            <div class="cart-line__price">
                                <small>Đơn giá</small>

                                @if (item.IsOnSale)
                                {
                                    <span>
                                        @item.OriginalPrice.ToString("N0", culture) ₫
                                    </span>
                                }

                                <strong data-cart-unit-price>
                                    @item.EffectivePrice.ToString("N0", culture) ₫
                                </strong>
                                <em>Còn @item.StockQuantity sản phẩm</em>
                            </div>

                            <div class="cart-line__quantity">
                                <small>Số lượng</small>
                                <div class="quantity-control">
                                    <button type="button"
                                            data-cart-quantity-minus
                                            aria-label="Giảm số lượng @item.ProductName"
                                            disabled="@(item.Quantity <= 1 || !item.IsAvailable ? "disabled" : null)">
                                        −
                                    </button>
                                    <input type="number"
                                           min="1"
                                           max="@Math.Max(1, item.MaxQuantity)"
                                           value="@item.Quantity"
                                           inputmode="numeric"
                                           data-cart-quantity
                                           aria-label="Số lượng @item.ProductName"
                                           disabled="@(!item.IsAvailable ? "disabled" : null)" />
                                    <button type="button"
                                            data-cart-quantity-plus
                                            aria-label="Tăng số lượng @item.ProductName"
                                            disabled="@(item.Quantity >= item.MaxQuantity || !item.IsAvailable ? "disabled" : null)">
                                        +
                                    </button>
                                </div>
                                <small>Tối đa @item.MaxQuantity</small>
                            </div>

                            <div class="cart-line__total">
                                <span>Thành tiền</span>
                                <strong data-cart-line-total>
                                    @item.LineTotal.ToString("N0", culture) ₫
                                </strong>
                                <button type="button"
                                        class="cart-line__remove"
                                        data-cart-remove>
                                    Xóa khỏi giỏ
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <aside class="cart-summary"
                   aria-labelledby="cart-summary-heading"
                   data-reveal>
                <span class="cart-summary__shine" aria-hidden="true"></span>
                <p class="eyebrow">Tóm tắt giỏ hàng</p>
                <h2 id="cart-summary-heading">Sản phẩm đã chọn</h2>

                <dl>
                    <div>
                        <dt>Số dòng đã chọn</dt>
                        <dd data-cart-selected-lines>
                            @Model.SelectedLineCount
                        </dd>
                    </div>
                    <div>
                        <dt>Tổng số lượng</dt>
                        <dd data-cart-selected-quantity>
                            @Model.SelectedQuantity
                        </dd>
                    </div>
                    <div>
                        <dt>Sản phẩm cần kiểm tra</dt>
                        <dd data-cart-unavailable-count>
                            @Model.UnavailableLineCount
                        </dd>
                    </div>
                    <div class="cart-summary__total">
                        <dt>Tạm tính</dt>
                        <dd data-cart-selected-subtotal>
                            @Model.SelectedSubtotal.ToString("N0", culture) ₫
                        </dd>
                    </div>
                </dl>

                <button type="button"
                        class="button button--primary cart-summary__checkout"
                        data-prepare-checkout
                        disabled="@(!Model.HasSelectedItems ? "disabled" : null)">
                    Tiến hành thanh toán
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14m-6-6 6 6-6 6" />
                    </svg>
                </button>

                <p class="cart-summary__hint">
                    Phí giao hàng sẽ được tính ở bước tiếp theo theo địa chỉ nhận hàng.
                </p>

                <div class="cart-summary__result"
                     data-checkout-result
                     role="status"
                     hidden></div>
            </aside>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/pages/storefront/cart.js"
            asp-append-version="true"></script>
}
