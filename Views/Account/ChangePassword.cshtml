@model WebApplication2.ViewModels.Storefront.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/storefront/account.css" asp-append-version="true" />
}

<section class="account-page shell-container">
    <div class="account-card">
        <header>
            <span class="account-card__eyebrow">Bảo mật tài khoản</span>
            <h1>Đổi mật khẩu</h1>
            <p>Sau khi đổi mật khẩu, phiên đăng nhập hiện tại sẽ được cấp lại an toàn.</p>
        </header>

        <form asp-action="ChangePassword" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="account-validation"></div>
            <label>
                <span>Mật khẩu hiện tại</span>
                <input asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </label>
            <label>
                <span>Mật khẩu mới</span>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </label>
            <label>
                <span>Xác nhận mật khẩu mới</span>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </label>
            <button type="submit" class="button button--primary">Cập nhật mật khẩu</button>
        </form>
    </div>
</section>
