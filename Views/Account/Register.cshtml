@model WebApplication2.ViewModels.Storefront.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/storefront/account.css" asp-append-version="true" />
}

<section class="account-page shell-container">
    <div class="account-card account-card--wide">
        <header>
            <span class="account-card__eyebrow">Thành viên FastBuy</span>
            <h1>Tạo tài khoản</h1>
            <p>Lưu địa chỉ giao hàng và quản lý toàn bộ đơn mua tại một nơi.</p>
        </header>

        <form asp-action="Register" method="post" class="account-form account-form--grid">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="account-validation account-field--wide"></div>

            <label>
                <span>Tên đăng nhập</span>
                <input asp-for="Username" autocomplete="username" />
                <span asp-validation-for="Username"></span>
            </label>

            <label>
                <span>Email</span>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </label>

            <label>
                <span>Họ và tên</span>
                <input asp-for="FullName" autocomplete="name" />
                <span asp-validation-for="FullName"></span>
            </label>

            <label>
                <span>Số điện thoại</span>
                <input asp-for="PhoneNumber" autocomplete="tel" inputmode="numeric" />
                <span asp-validation-for="PhoneNumber"></span>
            </label>

            <label>
                <span>Mật khẩu</span>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </label>

            <label>
                <span>Xác nhận mật khẩu</span>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </label>

            <button type="submit" class="button button--primary account-field--wide">Tạo tài khoản</button>
        </form>

        <footer>
            Đã có tài khoản?
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a>
        </footer>
    </div>
</section>
