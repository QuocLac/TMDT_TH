@using WebApplication2.Models.Enums
@using WebApplication2.Services.Shipping.Internal
@model WebApplication2.Areas.Admin.ViewModels.Shipping.ShippingAdminDetailsViewModel
@{
    ViewData["Title"] = $"Giao hàng {Model.OrderCode}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/shipping.css" asp-append-version="true" />
}

<section class="admin-page shipping-page">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Đơn hàng @Model.OrderCode</p>
            <h2>@Model.StatusText</h2>
            <p class="admin-page-lead">
                @Model.CustomerName · @Model.CustomerPhone<br />
                @Model.ShippingAddress
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a asp-area="Admin"
               asp-controller="Orders"
               asp-action="Details"
               asp-route-id="@Model.OrderId"
               class="button button--secondary">
                Xem đơn hàng
            </a>
            <a asp-action="Index" class="button button--secondary">
                Danh sách giao vận
            </a>
        </div>
    </header>

    <ol class="shipping-progress" aria-label="Tiến trình giao hàng">
        @foreach (var step in Model.Progress)
        {
            <li class="@(step.IsComplete ? "is-complete" : null) @(step.IsCurrent ? "is-current" : null)">
                <span>
                    @if (step.IsComplete && !step.IsCurrent)
                    {
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                    }
                    else
                    {
                        @step.Position
                    }
                </span>
                <div>
                    <strong>@step.Title</strong>
                    <small>@step.Description</small>
                </div>
            </li>
        }
    </ol>

    <div class="shipping-detail-layout">
        <main>
            <section class="admin-panel shipping-summary-card">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Thông tin giao hàng</p>
                        <h3>
                            @(string.IsNullOrWhiteSpace(Model.TrackingCode)
                                ? "Chưa cấp mã theo dõi"
                                : Model.TrackingCode)
                        </h3>
                        <p>@Model.ServiceName</p>
                    </div>
                    <span class="shipping-status shipping-status--@Model.Status.ToString().ToLowerInvariant()">
                        @Model.StatusText
                    </span>
                </header>

                <dl class="shipping-summary-grid">
                    <div><dt>Khách hàng</dt><dd>@Model.CustomerName</dd></div>
                    <div><dt>Số điện thoại</dt><dd>@Model.CustomerPhone</dd></div>
                    <div class="is-wide"><dt>Địa chỉ</dt><dd>@Model.ShippingAddress</dd></div>
                    <div><dt>Phí giao hàng</dt><dd>@Model.Fee.ToString("N0") ₫</dd></div>
                    <div><dt>Thu khi nhận</dt><dd>@Model.CodAmount.ToString("N0") ₫</dd></div>
                    <div><dt>Thanh toán</dt><dd>@Model.PaymentStatus</dd></div>
                    <div><dt>Đơn hàng</dt><dd>@Model.FulfillmentStatus</dd></div>
                    <div>
                        <dt>Dự kiến giao</dt>
                        <dd>@(Model.EstimatedDeliveryAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Chưa xác định")</dd>
                    </div>
                    <div>
                        <dt>Bàn giao lúc</dt>
                        <dd>@(Model.CarrierHandoffAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa bàn giao")</dd>
                    </div>
                    <div>
                        <dt>Hoàn tất lúc</dt>
                        <dd>@(Model.DeliveredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa hoàn tất")</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="shipping-note">
                        <strong>Ghi chú gần nhất</strong>
                        <p>@Model.Note</p>
                    </div>
                }
            </section>

            <section class="admin-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Lịch sử</p>
                        <h3>Cập nhật giao hàng</h3>
                    </div>
                </header>

                @if (Model.History.Count == 0)
                {
                    <div class="admin-empty-state admin-empty-state--compact">
                        <div>
                            <strong>Chưa có cập nhật</strong>
                            <span>Thao tác tiếp theo sẽ được ghi nhận tại đây.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="shipping-history">
                        @foreach (var item in Model.History)
                        {
                            <article>
                                <span aria-hidden="true"></span>
                                <div>
                                    <small>
                                        @item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        · @item.ChangedBy
                                    </small>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p>@item.Description</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </main>

        <aside>
            <section class="admin-panel shipping-action-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Bước tiếp theo</p>
                        <h3>Cập nhật tiến trình</h3>
                        <p>Chỉ các bước hợp lệ từ trạng thái hiện tại được hiển thị.</p>
                    </div>
                </header>

                @if (Model.AllowedTargets.Count == 0)
                {
                    <div class="shipping-complete-state">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        <strong>Không còn bước cần cập nhật</strong>
                        <span>Hồ sơ giao hàng đã ở trạng thái kết thúc.</span>
                    </div>
                }
                else
                {
                    <form asp-action="Transition"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="shipping-action-form"
                          data-shipping-transition-form>
                        <input type="hidden"
                               name="RowVersion"
                               value="@Model.RowVersion" />

                        <label>
                            <span>Trạng thái mới</span>
                            <select name="TargetStatus" required>
                                @foreach (var target in Model.AllowedTargets)
                                {
                                    <option value="@target">
                                        @InternalShippingLifecycleService.StatusTitle(target)
                                    </option>
                                }
                            </select>
                        </label>

                        <label>
                            <span>Ghi chú cho khách hàng</span>
                            <textarea name="Note"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Ví dụ: Đơn đã được đóng gói cẩn thận và sẵn sàng bàn giao."></textarea>
                        </label>

                        <button type="submit" class="button button--primary">
                            Lưu cập nhật
                        </button>
                    </form>
                }
            </section>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/admin/shipping.js" asp-append-version="true"></script>
}
