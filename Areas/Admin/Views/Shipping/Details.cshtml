@model WebApplication2.Areas.Admin.ViewModels.Shipping.ShippingAdminDetailsViewModel
@{
    ViewData["Title"] = $"Vận chuyển {Model.OrderCode}";
    var ghnEnabled = ViewBag.GhnEnabled is true;
    var defaultServiceTypeId = (int?)ViewBag.DefaultServiceTypeId ?? 2;
}

<section class="admin-page shipping-page" data-shipping-details data-shipment-id="@Model.Id">
    <header class="admin-page-header">
        <div>
            <p class="eyebrow">GHN shipment execution</p>
            <h2>@Model.OrderCode</h2>
            <p class="admin-page-lead">
                Shipment #@Model.Id · @Model.CustomerName · @Model.ShippingAddress
            </p>
        </div>
        <div class="shipping-header-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Danh sách shipment</a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Details"
               asp-route-id="@Model.OrderId" class="btn btn-outline-primary">Mở đơn hàng</a>
        </div>
    </header>

    @if (!ghnEnabled)
    {
        <div class="alert alert-warning">
            GHN đang tắt. Hãy cấu hình User Secrets hoặc biến môi trường trước khi gọi Sandbox.
        </div>
    }

    <div class="shipping-metric-grid">
        <article><span>Chiều vận đơn</span><strong>@Model.Direction</strong></article>
        <article><span>Shipment nội bộ</span><strong>@Model.Status</strong></article>
        <article><span>Provider status</span><strong>@(Model.ProviderStatus ?? "Chưa đồng bộ")</strong></article>
        <article><span>Fulfillment</span><strong>@Model.FulfillmentStatus</strong></article>
        <article><span>Thanh toán</span><strong>@Model.PaymentStatus</strong></article>
        <article><span>Tracking</span><strong>@(Model.TrackingCode ?? "Chưa tạo")</strong></article>
    </div>

    <div class="shipping-layout">
        <div class="shipping-main">
            <section class="data-panel shipping-section">
                <div class="shipping-section-heading">
                    <div>
                        <p class="eyebrow">Provider action</p>
                        <h3>Báo giá và tạo vận đơn</h3>
                    </div>
                    <button type="button" class="btn btn-outline-secondary" data-sync-shipment
                            disabled="@((!ghnEnabled || string.IsNullOrWhiteSpace(Model.ExternalOrderCode)) ? "disabled" : null)">
                        Đồng bộ GHN
                    </button>
                </div>

                <form class="shipping-execution-form" data-shipping-form>
                    <label>
                        <span>Dịch vụ GHN</span>
                        <select name="serviceId" data-service-select disabled="@(!ghnEnabled ? "disabled" : null)">
                            <option value="">Tải danh sách dịch vụ...</option>
                        </select>
                    </label>
                    <label>
                        <span>Loại dịch vụ</span>
                        <select name="serviceTypeId">
                            @if (defaultServiceTypeId == 2)
                            {
                                <option value="2" selected>Hàng nhẹ (2)</option>
                                <option value="5">Hàng nặng (5)</option>
                            }
                            else
                            {
                                <option value="2">Hàng nhẹ (2)</option>
                                <option value="5" selected>Hàng nặng (5)</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Khối lượng (gram)</span>
                        <input name="weightGram" type="number" min="1" max="50000" value="@Model.WeightGram" required />
                    </label>
                    <label>
                        <span>Dài (cm)</span>
                        <input name="lengthCm" type="number" min="1" max="200" value="@Model.LengthCm" required />
                    </label>
                    <label>
                        <span>Rộng (cm)</span>
                        <input name="widthCm" type="number" min="1" max="200" value="@Model.WidthCm" required />
                    </label>
                    <label>
                        <span>Cao (cm)</span>
                        <input name="heightCm" type="number" min="1" max="200" value="@Model.HeightCm" required />
                    </label>
                    <label class="shipping-field-wide">
                        <span>Ghi chú cho shipper</span>
                        <textarea name="note" maxlength="500" rows="3">Gọi khách trước khi giao.</textarea>
                    </label>
                    <div class="shipping-actions shipping-field-wide">
                        <button type="button" class="btn btn-outline-primary" data-quote-shipment
                                disabled="@(!ghnEnabled ? "disabled" : null)">Lấy báo giá</button>
                        <button type="button" class="btn btn-primary" data-create-shipment
                                disabled="@((!ghnEnabled || !Model.CanQueueCreate) ? "disabled" : null)">
                            Xếp hàng tạo vận đơn
                        </button>
                    </div>
                </form>

                <div class="shipping-result" data-shipping-result hidden></div>
            </section>

            <section class="data-panel shipping-section">
                <div class="shipping-section-heading">
                    <div>
                        <p class="eyebrow">Cancellation</p>
                        <h3>Hủy vận đơn</h3>
                    </div>
                </div>
                <div class="shipping-cancel-row">
                    <textarea data-cancel-reason maxlength="500" rows="3"
                              placeholder="Lý do hủy vận đơn..."></textarea>
                    <button type="button" class="btn btn-outline-danger" data-cancel-shipment
                            disabled="@(!Model.CanRequestCancellation ? "disabled" : null)">
                        Xếp hàng hủy vận đơn
                    </button>
                </div>
                <div class="shipping-safety-note">
                    @if (!Model.HasPendingOrderCancellation)
                    {
                        <strong>Chưa có cancellation request Pending.</strong>
                        <span>Hãy tạo yêu cầu hủy tại trang đơn hàng trước khi gửi lệnh hủy vận đơn.</span>
                    }
                    <span>Sau khi GHN chuyển sang Picking/InTransit, cancellation bị khóa. Khách hàng chỉ có thể gửi return request sau khi Delivered và trong thời hạn 7 ngày.</span>
                </div>
            </section>

            <section class="data-panel shipping-section">
                <div class="shipping-section-heading">
                    <div>
                        <p class="eyebrow">Provider snapshot</p>
                        <h3>Dữ liệu vận đơn</h3>
                    </div>
                </div>
                <dl class="shipping-snapshot">
                    <div><dt>External code</dt><dd>@(Model.ExternalOrderCode ?? "—")</dd></div>
                    <div><dt>Provider status</dt><dd>@(Model.ProviderStatus ?? "—")</dd></div>
                    <div><dt>Dịch vụ</dt><dd>@(Model.ServiceName ?? Model.ServiceCode ?? "—")</dd></div>
                    <div><dt>Phí</dt><dd>@Model.Fee.ToString("N0") ₫</dd></div>
                    <div><dt>COD</dt><dd>@Model.CodAmount.ToString("N0") ₫</dd></div>
                    <div><dt>Kiện hàng</dt><dd>@Model.WeightGram g · @Model.LengthCm×@Model.WidthCm×@Model.HeightCm cm</dd></div>
                    <div><dt>Dự kiến giao</dt><dd>@(Model.EstimatedDeliveryAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
                    <div><dt>Provider cập nhật</dt><dd>@(Model.ProviderUpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Đồng bộ gần nhất</dt><dd>@(Model.LastSyncedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Carrier handoff</dt><dd>@(Model.CarrierHandoffAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Delivered</dt><dd>@(Model.DeliveredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Hạn return</dt><dd>@(Model.ReturnDeadlineAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Yêu cầu hủy</dt><dd>@(Model.CancelRequestedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Đã hủy</dt><dd>@(Model.CancelledAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Shipper</dt><dd>@(Model.ShipperName ?? "—") @(Model.ShipperPhone)</dd></div>
                    <div><dt>Hub hiện tại</dt><dd>@(Model.CurrentHub ?? "—")</dd></div>
                    <div class="shipping-snapshot-wide"><dt>Lý do provider</dt><dd>@(Model.ProviderReason ?? "—")</dd></div>
                </dl>
            </section>
        </div>

        <aside class="shipping-side">
            <section class="data-panel shipping-section">
                <div class="shipping-section-heading">
                    <div>
                        <p class="eyebrow">Outbox</p>
                        <h3>Yêu cầu gửi GHN</h3>
                    </div>
                </div>
                <div class="shipping-event-list">
                    @if (Model.Outbox.Count == 0)
                    {
                        <p>Chưa có outbox message.</p>
                    }
                    @foreach (var item in Model.Outbox)
                    {
                        <article>
                            <header><strong>@item.Type</strong><span>@item.Status</span></header>
                            <small>@item.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") · lần @item.AttemptCount</small>
                            @if (item.NextAttemptAt.HasValue)
                            {
                                <small>Retry: @item.NextAttemptAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.LastError))
                            {
                                <p class="text-danger">@item.LastError</p>
                            }
                        </article>
                    }
                </div>
            </section>

            <section class="data-panel shipping-section">
                <div class="shipping-section-heading">
                    <div>
                        <p class="eyebrow">Inbox</p>
                        <h3>Webhook GHN</h3>
                    </div>
                </div>
                <div class="shipping-event-list">
                    @if (Model.Inbox.Count == 0)
                    {
                        <p>Chưa nhận webhook.</p>
                    }
                    @foreach (var item in Model.Inbox)
                    {
                        <article>
                            <header><strong>@item.Type</strong><span>@item.Status</span></header>
                            <small>@item.ReceivedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")</small>
                            @if (!string.IsNullOrWhiteSpace(item.LastError))
                            {
                                <p>@item.LastError</p>
                            }
                        </article>
                    }
                </div>
            </section>
        </aside>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/shipping.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/admin/shipping.js" asp-append-version="true"></script>
}
