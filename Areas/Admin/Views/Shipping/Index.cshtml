@using WebApplication2.Models.Enums
@using WebApplication2.Services.Shipping.Internal
@model WebApplication2.Areas.Admin.ViewModels.Shipping.ShippingAdminIndexViewModel
@{
    ViewData["Title"] = "Giao vận";
    var waiting = Model.Items.Count(item =>
        item.Status is ShipmentStatus.Draft
            or ShipmentStatus.PendingCreation
            or ShipmentStatus.Picking);
    var ready = Model.Items.Count(item => item.Status == ShipmentStatus.Created);
    var moving = Model.Items.Count(item => item.Status == ShipmentStatus.InTransit);
    var delivered = Model.Items.Count(item => item.Status == ShipmentStatus.Delivered);
    var attention = Model.Items.Count(item =>
        item.Status is ShipmentStatus.DeliveryFailed
            or ShipmentStatus.Returning
            or ShipmentStatus.Exception);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/shipping.css" asp-append-version="true" />
}

<section class="admin-page shipping-page">
    <header class="admin-page-header admin-page-header--hero">
        <div class="admin-page-header__copy">
            <p class="admin-page-kicker">Điều phối đơn hàng</p>
            <h2>Giao vận</h2>
            <p class="admin-page-lead">
                Cập nhật tiến trình giao hàng trực tiếp theo từng bước,
                từ chuẩn bị hàng đến khi khách nhận thành công.
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a asp-area="Admin"
               asp-controller="Orders"
               asp-action="Index"
               asp-route-fulfillmentStatus="ReadyToShip"
               class="button button--primary">
                <i class="fa-solid fa-box" aria-hidden="true"></i>
                Đơn sẵn sàng giao
            </a>
        </div>
    </header>

    <section class="shipping-metrics" aria-label="Tổng quan giao vận">
        <article>
            <span><i class="fa-solid fa-boxes-packing" aria-hidden="true"></i></span>
            <div><small>Đang chuẩn bị</small><strong>@waiting</strong></div>
        </article>
        <article>
            <span><i class="fa-solid fa-box" aria-hidden="true"></i></span>
            <div><small>Sẵn sàng giao</small><strong>@ready</strong></div>
        </article>
        <article>
            <span><i class="fa-solid fa-truck-fast" aria-hidden="true"></i></span>
            <div><small>Đang giao</small><strong>@moving</strong></div>
        </article>
        <article>
            <span><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
            <div><small>Đã giao</small><strong>@delivered</strong></div>
        </article>
        <article class="is-attention">
            <span><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
            <div><small>Cần xử lý</small><strong>@attention</strong></div>
        </article>
    </section>

    <section class="admin-filter-panel">
        <div class="admin-filter-panel__header">
            <div>
                <p class="admin-page-kicker">Bộ lọc</p>
                <h3>Tìm hồ sơ giao hàng</h3>
            </div>
            <span>@Model.Items.Count kết quả</span>
        </div>

        <form method="get" class="admin-filter-grid admin-filter-grid--compact">
            <label class="admin-filter-field">
                <span>Tìm kiếm</span>
                <input name="search"
                       value="@Model.Search"
                       type="search"
                       placeholder="Mã đơn, khách hàng hoặc mã giao hàng" />
            </label>

            <label class="admin-filter-field">
                <span>Trạng thái</span>
                <select name="status">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var status in Enum.GetValues<ShipmentStatus>())
                    {
                        if (Model.Status == status)
                        {
                            <option value="@status" selected>@InternalShippingLifecycleService.StatusTitle(status)</option>
                        }
                        else
                        {
                            <option value="@status">@InternalShippingLifecycleService.StatusTitle(status)</option>
                        }
                    }
                </select>
            </label>

            <div class="admin-filter-actions">
                <button class="button button--primary" type="submit">
                    Áp dụng
                </button>
            </div>
            <div class="admin-filter-actions">
                <a asp-action="Index" class="button button--secondary">Xóa lọc</a>
            </div>
        </form>
    </section>

    <section class="admin-panel shipping-list-panel">
        <header class="admin-panel__header">
            <div>
                <p class="admin-page-kicker">Danh sách</p>
                <h3>Tiến trình giao hàng</h3>
                <p>Mở từng hồ sơ để cập nhật bước tiếp theo.</p>
            </div>
        </header>

        @if (Model.Items.Count == 0)
        {
            <div class="admin-empty-state">
                <i class="fa-solid fa-truck" aria-hidden="true"></i>
                <div>
                    <strong>Không có hồ sơ phù hợp</strong>
                    <span>Hãy thay đổi từ khóa hoặc trạng thái lọc.</span>
                </div>
            </div>
        }
        else
        {
            <div class="shipping-list">
                @foreach (var item in Model.Items)
                {
                    <article class="shipping-list-card">
                        <div class="shipping-list-card__identity">
                            <span class="shipping-list-card__icon">
                                <i class="fa-solid fa-box" aria-hidden="true"></i>
                            </span>
                            <div>
                                <strong>@item.OrderCode</strong>
                                <span>@item.CustomerName</span>
                                <small>
                                    @(string.IsNullOrWhiteSpace(item.TrackingCode)
                                        ? "Mã theo dõi sẽ được cấp khi sẵn sàng giao"
                                        : item.TrackingCode)
                                </small>
                                <small>@item.ServiceName</small>
                            </div>
                        </div>

                        <div class="shipping-list-card__status">
                            <span class="shipping-status shipping-status--@item.Status.ToString().ToLowerInvariant()">
                                @item.StatusText
                            </span>
                            <small>
                                Cập nhật @((item.UpdatedAt ?? item.CreatedAt)
                                    .ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                            </small>
                        </div>

                        <dl>
                            <div>
                                <dt>Phí giao hàng</dt>
                                <dd>@item.Fee.ToString("N0") ₫</dd>
                            </div>
                            <div>
                                <dt>Thu khi nhận</dt>
                                <dd>@item.CodAmount.ToString("N0") ₫</dd>
                            </div>
                        </dl>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="button button--secondary button--small">
                            Mở hồ sơ
                        </a>
                    </article>
                }
            </div>
        }
    </section>
</section>
