@using System.Globalization
@using WebApplication2.Areas.Admin.Presentation
@model WebApplication2.Areas.Admin.ViewModels.Home.AdminDashboardViewModel

@{
    ViewData["Title"] = "Tổng quan vận hành";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/dashboard.css" asp-append-version="true" />
}

<section class="admin-page admin-dashboard">
    <header class="admin-page-header admin-page-header--hero">
        <div class="admin-page-header__copy">
            <p class="admin-page-kicker">Trung tâm điều hành</p>
            <h2>Hoạt động kinh doanh hôm nay</h2>
            <p class="admin-page-lead">
                Theo dõi đơn hàng, doanh thu đã thanh toán, giao vận, hoàn trả và tồn kho
                trong một màn hình vận hành thống nhất.
            </p>
            <span class="admin-page-meta">
                Cập nhật lúc @Model.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <div class="admin-page-header__actions">
            <a asp-area="Admin"
               asp-controller="Orders"
               asp-action="Index"
               class="button button--primary">
                <i class="fa-solid fa-receipt" aria-hidden="true"></i>
                Xử lý đơn hàng
            </a>
            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Create"
               class="button button--secondary">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Thêm sản phẩm
            </a>
        </div>
    </header>

    <section class="admin-metric-grid admin-metric-grid--six" aria-label="Chỉ số bán hàng">
        <article class="admin-metric-card admin-metric-card--info">
            <span class="admin-metric-card__icon" aria-hidden="true">
                <i class="fa-solid fa-bag-shopping"></i>
            </span>
            <div>
                <span class="admin-metric-card__label">Đơn phát sinh hôm nay</span>
                <strong class="admin-metric-card__value">@Model.OrdersTodayCount</strong>
                <small class="admin-metric-card__meta">Tính theo thời điểm tạo đơn</small>
            </div>
        </article>

        <article class="admin-metric-card admin-metric-card--success">
            <span class="admin-metric-card__icon" aria-hidden="true">
                <i class="fa-solid fa-coins"></i>
            </span>
            <div>
                <span class="admin-metric-card__label">Doanh thu đã thanh toán</span>
                <strong class="admin-metric-card__value admin-metric-card__value--money">
                    @Model.PaidRevenueToday.ToString("N0", culture) ₫
                </strong>
                <small class="admin-metric-card__meta">Không tính giao dịch đang chờ</small>
            </div>
        </article>

        <article class="admin-metric-card admin-metric-card--warning">
            <span class="admin-metric-card__icon" aria-hidden="true">
                <i class="fa-solid fa-clock"></i>
            </span>
            <div>
                <span class="admin-metric-card__label">Chờ xác nhận</span>
                <strong class="admin-metric-card__value">@Model.AwaitingConfirmationCount</strong>
                <small class="admin-metric-card__meta">Cần kiểm tra và tiếp nhận</small>
            </div>
        </article>

        <article class="admin-metric-card admin-metric-card--info">
            <span class="admin-metric-card__icon" aria-hidden="true">
                <i class="fa-solid fa-box"></i>
            </span>
            <div>
                <span class="admin-metric-card__label">Sẵn sàng bàn giao</span>
                <strong class="admin-metric-card__value">@Model.ReadyToShipCount</strong>
                <small class="admin-metric-card__meta">Có thể tạo hoặc bàn giao vận đơn</small>
            </div>
        </article>

        <article class="admin-metric-card admin-metric-card--danger">
            <span class="admin-metric-card__icon" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </span>
            <div>
                <span class="admin-metric-card__label">Vận chuyển cần kiểm tra</span>
                <strong class="admin-metric-card__value">@Model.ShippingExceptionCount</strong>
                <small class="admin-metric-card__meta">Giao chưa thành công hoặc có ngoại lệ</small>
            </div>
        </article>

        <article class="admin-metric-card admin-metric-card--warning">
            <span class="admin-metric-card__icon" aria-hidden="true">
                <i class="fa-solid fa-rotate-left"></i>
            </span>
            <div>
                <span class="admin-metric-card__label">Hoàn trả đang xử lý</span>
                <strong class="admin-metric-card__value">@Model.OpenReturnCount</strong>
                <small class="admin-metric-card__meta">Từ tiếp nhận đến chờ hoàn tiền</small>
            </div>
        </article>
    </section>

    <section class="dashboard-work-queue" aria-label="Hàng đợi công việc">
        <a asp-area="Admin"
           asp-controller="Orders"
           asp-action="Index"
           asp-route-orderStatus="Placed"
           class="dashboard-work-card">
            <span class="dashboard-work-card__icon" aria-hidden="true">
                <i class="fa-solid fa-clipboard-check"></i>
            </span>
            <div>
                <strong>Xác nhận đơn mới</strong>
                <span>@Model.AwaitingConfirmationCount đơn đang chờ</span>
            </div>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </a>

        <a asp-area="Admin"
           asp-controller="Shipping"
           asp-action="Index"
           class="dashboard-work-card">
            <span class="dashboard-work-card__icon" aria-hidden="true">
                <i class="fa-solid fa-truck-fast"></i>
            </span>
            <div>
                <strong>Điều phối giao hàng</strong>
                <span>@Model.ReadyToShipCount đơn sẵn sàng bàn giao</span>
            </div>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </a>

        <a asp-area="Admin"
           asp-controller="Returns"
           asp-action="Index"
           class="dashboard-work-card">
            <span class="dashboard-work-card__icon" aria-hidden="true">
                <i class="fa-solid fa-box-archive"></i>
            </span>
            <div>
                <strong>Xử lý hoàn trả</strong>
                <span>@Model.OpenReturnCount yêu cầu đang mở</span>
            </div>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="dashboard-work-card">
            <span class="dashboard-work-card__icon" aria-hidden="true">
                <i class="fa-solid fa-boxes-stacked"></i>
            </span>
            <div>
                <strong>Kiểm tra tồn kho</strong>
                <span>@(Model.LowStockVariantCount + Model.OutOfStockVariantCount) biến thể cần chú ý</span>
            </div>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </a>
    </section>

    <section class="admin-panel dashboard-orders-panel" aria-labelledby="recent-orders-heading">
        <header class="admin-panel__header">
            <div>
                <p class="admin-page-kicker">Bán hàng gần đây</p>
                <h3 id="recent-orders-heading">Đơn hàng mới nhất</h3>
                <p>Theo dõi nhanh tình trạng đơn, thanh toán và giao hàng.</p>
            </div>
            <a asp-area="Admin"
               asp-controller="Orders"
               asp-action="Index"
               class="admin-text-link">
                Xem tất cả đơn
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="admin-table-wrap">
            <table class="admin-data-table">
                <thead>
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái đơn</th>
                        <th>Thanh toán</th>
                        <th>Giao hàng</th>
                        <th class="text-end">Tổng tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty-state admin-empty-state--compact">
                                    <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
                                    <div>
                                        <strong>Chưa có đơn hàng</strong>
                                        <span>Đơn mới sẽ xuất hiện tại đây sau khi khách đặt hàng.</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <span class="admin-cell-primary">@order.Code</span>
                                    <span class="admin-cell-secondary">
                                        @order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                    </span>
                                </td>
                                <td>
                                    <span class="admin-cell-primary">@order.CustomerName</span>
                                </td>
                                <td>
                                    <span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(order.OrderStatus)">
                                        @AdminCommerceDisplay.OrderStatusText(order.OrderStatus)
                                    </span>
                                </td>
                                <td>
                                    <span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(order.PaymentStatus)">
                                        @AdminCommerceDisplay.PaymentStatusText(order.PaymentStatus)
                                    </span>
                                </td>
                                <td>
                                    <span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(order.FulfillmentStatus)">
                                        @AdminCommerceDisplay.FulfillmentStatusText(order.FulfillmentStatus)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="admin-cell-money">
                                        @order.GrandTotal.ToString("N0", culture) ₫
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin"
                                       asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.OrderId"
                                       class="admin-row-action"
                                       aria-label="Mở đơn @order.Code">
                                        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="dashboard-grid">
        <section class="admin-panel" aria-labelledby="inventory-heading">
            <header class="admin-panel__header">
                <div>
                    <p class="admin-page-kicker">Tồn kho</p>
                    <h3 id="inventory-heading">Biến thể cần chú ý</h3>
                    <p>
                        @Model.ActiveProductCount sản phẩm đang hoạt động ·
                        @Model.OutOfStockVariantCount biến thể đã hết hàng
                    </p>
                </div>
                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="admin-text-link">
                    Quản lý kho
                </a>
            </header>

            @if (Model.LowStockItems.Count == 0)
            {
                <div class="admin-empty-state">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <div>
                        <strong>Tồn kho đang ổn định</strong>
                        <span>Chưa có biến thể nào dưới ngưỡng cảnh báo.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var item in Model.LowStockItems)
                    {
                        <article class="dashboard-list-item">
                            <div class="dashboard-list-item__main">
                                <span class="dashboard-list-item__icon" aria-hidden="true">
                                    <i class="fa-solid fa-box"></i>
                                </span>
                                <div>
                                    <a asp-area="Admin"
                                       asp-controller="Products"
                                       asp-action="Edit"
                                       asp-route-id="@item.ProductId"
                                       class="dashboard-list-item__title">
                                        @item.ProductName
                                    </a>
                                    <p>@item.SKU · @item.CurrentPrice.ToString("N0", culture) ₫</p>
                                </div>
                            </div>
                            <span class="admin-badge @(item.StockQuantity == 0 ? "admin-badge--danger" : "admin-badge--warning")">
                                @(item.StockQuantity == 0 ? "Hết hàng" : $"Còn {item.StockQuantity}")
                            </span>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="admin-panel" aria-labelledby="campaign-heading">
            <header class="admin-panel__header">
                <div>
                    <p class="admin-page-kicker">Giá bán</p>
                    <h3 id="campaign-heading">Chiến dịch đang hiệu lực</h3>
                    <p>@Model.RunningCampaignCount chiến dịch hiện đang chạy.</p>
                </div>
                <a asp-area="Admin"
                   asp-controller="PriceCampaigns"
                   asp-action="Index"
                   class="admin-text-link">
                    Quản lý giá
                </a>
            </header>

            @if (Model.Campaigns.Count == 0)
            {
                <div class="admin-empty-state">
                    <i class="fa-solid fa-tags" aria-hidden="true"></i>
                    <div>
                        <strong>Chưa có chiến dịch gần đây</strong>
                        <span>Tạo chiến dịch để lên lịch điều chỉnh giá bán.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var campaign in Model.Campaigns)
                    {
                        <article class="dashboard-list-item">
                            <div>
                                <a asp-area="Admin"
                                   asp-controller="PriceCampaigns"
                                   asp-action="Edit"
                                   asp-route-id="@campaign.CampaignId"
                                   class="dashboard-list-item__title">
                                    @campaign.Name
                                </a>
                                <p>
                                    @campaign.StartDate.ToLocalTime().ToString("dd/MM HH:mm")
                                    –
                                    @campaign.EndDate.ToLocalTime().ToString("dd/MM HH:mm")
                                </p>
                                <small>@campaign.VariantCount biến thể</small>
                            </div>
                            <span class="admin-badge @(campaign.IsRunning ? "admin-badge--success" : "admin-badge--info")">
                                @(campaign.IsRunning ? "Đang chạy" : "Sắp diễn ra")
                            </span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>
