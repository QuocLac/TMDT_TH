@using WebApplication2.Models
@model IEnumerable<PriceHistory>
@{
    var filterProductName = ViewBag.FilterProductName as string;
    ViewData["Title"] = !string.IsNullOrEmpty(filterProductName)
        ? $"Nhật ký giá: {filterProductName}"
        : "Nhật ký biến động giá";
}

<section class="admin-page">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Kiểm toán giá bán</p>
            <h2>@ViewData["Title"]</h2>
            <p class="admin-page-lead">
                Theo dõi giá hiệu lực của từng SKU theo thời điểm, nguồn thay đổi và người thực hiện.
                Đây là nhật ký giá, không phải danh sách khuyến mãi, voucher hoặc flash sale.
            </p>
        </div>
        @if (!string.IsNullOrEmpty(filterProductName))
        {
            <a asp-controller="Products"
               asp-action="Index"
               class="button button--secondary">
                Quay lại sản phẩm
            </a>
        }
    </header>

    <section class="admin-panel">
        <header class="admin-panel__header">
            <div>
                <p class="admin-page-kicker">Lịch sử hiệu lực</p>
                <h3>Biến động giá theo SKU</h3>
                <p>Giá cũ và giá mới phản ánh thay đổi giá bán; giảm giá tại giỏ hàng phải được quản lý ở nghiệp vụ riêng.</p>
            </div>
        </header>

        <div class="admin-table-wrap">
            <table class="admin-data-table">
                <thead>
                    <tr>
                        <th>Thời điểm</th>
                        <th>Sản phẩm / SKU</th>
                        <th class="u-text-end">Giá cũ</th>
                        <th class="u-text-end">Giá mới</th>
                        <th class="u-text-center">Biến động</th>
                        <th>Người thực hiện</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var difference = item.NewPrice - item.OldPrice;
                            var differencePercent = item.OldPrice > 0
                                ? Math.Abs(difference) / item.OldPrice * 100
                                : 0;
                            var directionClass = difference > 0
                                ? "price-change price-change--increase"
                                : difference < 0
                                    ? "price-change price-change--decrease"
                                    : "price-change";
                            var sign = difference > 0 ? "+" : difference < 0 ? "-" : string.Empty;

                            <tr>
                                <td>
                                    <span class="admin-cell-primary">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    <span class="admin-cell-secondary">@item.CreatedAt.ToString("HH:mm:ss")</span>
                                </td>
                                <td>
                                    <span class="admin-cell-primary">@item.ProductVariant.Product.Name</span>
                                    <span class="admin-cell-secondary">Mã hàng: @item.ProductVariant.SKU</span>
                                </td>
                                <td class="u-text-end">@item.OldPrice.ToString("N0") ₫</td>
                                <td class="u-text-end"><strong>@item.NewPrice.ToString("N0") ₫</strong></td>
                                <td class="u-text-center">
                                    <span class="@directionClass">@differencePercent.ToString("0.0")%</span>
                                    <small class="admin-cell-secondary">
                                        @sign@Math.Abs(difference).ToString("N0") ₫
                                    </small>
                                </td>
                                <td>
                                    <span class="admin-cell-primary">@item.ChangedBy</span>
                                    <span class="admin-cell-secondary" title="@item.Note">@item.Note</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-state admin-empty-state--compact">
                                    <div>
                                        <strong>Chưa có biến động giá</strong>
                                        <span>Nhật ký sẽ xuất hiện khi giá hiệu lực của SKU thay đổi.</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
