@using WebApplication2.Models
@model IEnumerable<PriceHistory>
@{
    var filterProductName = ViewBag.FilterProductName as string;
    ViewData["Title"] = !string.IsNullOrEmpty(filterProductName)
                        ? $"Lịch sử giá: {filterProductName}"
                        : "Lịch sử Biến động Giá Toàn Sàn";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body py-3 bg-light d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1 text-dark fw-bold">
                        <i class="fa-solid fa-chart-line me-2"></i>
                        @(!string.IsNullOrEmpty(filterProductName) ? $"Lịch sử giá: {filterProductName}" : "Tổng quan Giá thị trường")
                    </h5>
                    <small class="text-muted">
                        @(!string.IsNullOrEmpty(filterProductName) ? "Chi tiết biến động giá của từng phiên bản (SKU) thuộc sản phẩm này." : "Theo dõi mọi thay đổi giá trị tài sản gốc của toàn bộ sản phẩm trên sàn.")
                    </small>
                </div>
                <div>
                    @if (!string.IsNullOrEmpty(filterProductName))
                    {
                        <a asp-controller="Products" asp-action="Index" class="btn btn-light border text-dark btn-sm">
                            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Sản phẩm
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-dark">
                <tr>
                    <th width="15%">Thời điểm</th>
                    <th width="30%">Sản phẩm / SKU</th>
                    <th width="15%" class="text-end">Giá cũ</th>
                    <th width="15%" class="text-end">Giá mới</th>
                    <th width="10%" class="text-center">Biến động</th>
                    <th width="15%">Người đổi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        decimal diff = item.NewPrice - item.OldPrice;
                        decimal diffPercent = (item.OldPrice > 0) ? (Math.Abs(diff) / item.OldPrice) * 100 : 0;

                        string colorClass = diff > 0 ? "text-danger" : "text-success";
                        string iconClass = diff > 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down";
                        string sign = diff > 0 ? "+" : "-";

                        <tr>
                            <td>
                                <div class="text-dark fw-semibold">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@item.CreatedAt.ToString("HH:mm:ss")</small>
                            </td>
                            <td>
                                <div class="text-dark fw-bold">@item.ProductVariant.Product.Name</div>
                                <code class="text-secondary border px-1 rounded">SKU: @item.ProductVariant.SKU</code>
                            </td>
                            <td class="text-end text-muted text-decoration-line-through">
                                @item.OldPrice.ToString("N0") đ
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @item.NewPrice.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                <div class="@colorClass fw-bold">
                                    <i class="fa-solid @iconClass me-1"></i> @diffPercent.ToString("0.0")%
                                </div>
                                <small class="text-muted">@sign@Math.Abs(diff).ToString("N0") đ</small>
                            </td>
                            <td>
                                <div class="text-dark"><i class="fa-solid fa-user-pen text-muted me-1"></i> @item.ChangedBy</div>
                                <small class="text-muted d-block text-truncate" style="max-width: 150px;" title="@item.Note">@item.Note</small>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-clock-rotate-left fs-2 mb-3 text-light"></i>
                            <p class="mb-0">Chưa có lịch sử thay đổi giá nào được ghi nhận cho sản phẩm này.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>