@using WebApplication2.Models
@using WebApplication2.Models.Enums
@model Product
@{
    ViewData["Title"] = "Chi tiết Sản phẩm";
    var mainImage = Model.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png";
    var gallery = Model.Images?.Where(i => !i.IsMain).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="btn btn-light border"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn text-white" style="background-color: var(--primary-moss);">
        <i class="fa-solid fa-pen-to-square"></i> Cập nhật sản phẩm
    </a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center">
                <img src="@mainImage" class="img-fluid rounded mb-3 border" alt="Main Image" style="max-height: 300px; object-fit: contain;">

                @if (gallery != null && gallery.Any())
                {
                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                        @foreach (var img in gallery)
                        {
                            <img src="@img.ImageUrl" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;" alt="Gallery Image">
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h3 class="fw-bold text-dark mb-1">@Model.Name</h3>
                <p class="text-muted mb-3"><i class="fa-solid fa-link"></i> Slug: <code>@Model.Slug</code></p>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-secondary">Danh mục:</div>
                    <div class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.Category?.Name ?? "Trống")</span></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-secondary">Trạng thái:</div>
                    <div class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="fa-solid fa-check"></i> Đang hiển thị</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="fa-solid fa-eye-slash"></i> Đang ẩn</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-secondary">Mô tả:</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-cubes text-secondary me-2"></i>Danh sách Phiên bản (Variants)</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>SKU</th>
                            <th>Thuộc tính</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variant in Model.Variants)
                        {
                            <tr>
                                <td class="fw-bold">@variant.SKU</td>
                                <td>
                                    <small class="d-block">Màu: @(string.IsNullOrEmpty(variant.Color) ? "-" : variant.Color)</small>
                                    <small class="d-block">Size: @(string.IsNullOrEmpty(variant.Size) ? "-" : variant.Size)</small>
                                </td>

                                <td class="align-middle">
                                    @if (variant.CurrentPrice < variant.Price)
                                    {
                                        <span class="text-muted text-decoration-line-through me-2" style="font-size: 0.85rem;">
                                            @variant.Price.ToString("N0") đ
                                        </span>
                                        <span class="text-danger fw-bold fs-6">
                                            @variant.CurrentPrice.ToString("N0") đ
                                            <span class="badge bg-danger ms-1" style="font-size: 0.7rem;"><i class="fa-solid fa-bolt"></i> Sale</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">@variant.Price.ToString("N0") đ</span>
                                    }
                                </td>

                                <td>@variant.StockQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.ProductPromotions != null && Model.ProductPromotions.Any())
        {
            <div class="card shadow-sm border-0 border-start border-4 border-danger">
                <div class="card-body">
                    <h6 class="fw-bold text-danger mb-3"><i class="fa-solid fa-tags me-2"></i>Chương trình Voucher/Khuyến mãi khác</h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var pp in Model.ProductPromotions)
                        {
                            <li class="mb-2">
                                <strong>@pp.Promotion.Name</strong>
                                <span class="badge bg-danger ms-2">Giảm @pp.Promotion.DiscountValue @(pp.Promotion.Unit == DiscountUnit.Percentage ? "%" : "đ")</span>
                                <small class="text-muted d-block mt-1"><i class="fa-regular fa-clock"></i> Từ @pp.Promotion.StartDate.ToString("dd/MM/yyyy") đến @pp.Promotion.EndDate.ToString("dd/MM/yyyy")</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>