@using WebApplication2.Models
@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var mainImage = Model.Images?.FirstOrDefault(item => item.IsMain)?.ImageUrl
        ?? "/images/no-image.png";
    var gallery = Model.Images?.Where(item => !item.IsMain).ToList() ?? [];
}

<section class="admin-page product-details-admin">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Chi tiết hàng hóa</p>
            <h2>@Model.Name</h2>
            <p class="admin-page-lead">
                @Model.Category?.Name · @(Model.Brand?.Name ?? "Không công bố thương hiệu")
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a asp-area="Admin"
               asp-controller="ProductInformation"
               asp-action="EditProduct"
               asp-route-productId="@Model.Id"
               class="button button--primary">
                Thông tin ngành hàng
            </a>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="button button--secondary">
                Chỉnh sửa sản phẩm
            </a>
            <a asp-action="Index" class="button button--secondary">
                Quay lại
            </a>
        </div>
    </header>

    <div class="product-details-admin__layout">
        <section class="admin-panel product-details-admin__media">
            <img src="@mainImage" alt="@Model.Name" />
            @if (gallery.Count > 0)
            {
                <div>
                    @foreach (var image in gallery)
                    {
                        <img src="@image.ImageUrl" alt="" loading="lazy" />
                    }
                </div>
            }
        </section>

        <div class="product-details-admin__content">
            <section class="admin-panel product-details-admin__summary">
                <dl>
                    <div><dt>Danh mục</dt><dd>@(Model.Category?.Name ?? "Chưa xác định")</dd></div>
                    <div><dt>Thương hiệu</dt><dd>@(Model.Brand?.Name ?? "Không công bố")</dd></div>
                    <div><dt>Đường dẫn</dt><dd>/products/@Model.Slug</dd></div>
                    <div><dt>Trạng thái</dt><dd>@(Model.IsActive ? "Đang hiển thị" : "Đang ẩn")</dd></div>
                </dl>
                <div class="product-details-admin__description">
                    <h3>Giới thiệu sản phẩm</h3>
                    <p>@(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Chưa có nội dung giới thiệu."
                        : Model.Description)</p>
                </div>
            </section>

            <section class="admin-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Mã hàng</p>
                        <h3>Các lựa chọn bán</h3>
                    </div>
                </header>

                <div class="admin-table-wrap">
                    <table class="admin-data-table">
                        <thead>
                            <tr>
                                <th>Mã hàng</th>
                                <th>Mô tả lựa chọn</th>
                                <th>Giá niêm yết</th>
                                <th>Giá đang áp dụng</th>
                                <th>Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Variants)
                            {
                                var selectionLabel = string.Join(
                                    " · ",
                                    new[] { item.Color, item.Size }
                                        .Where(value => !string.IsNullOrWhiteSpace(value)));

                                <tr>
                                    <td><strong>@item.SKU</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(selectionLabel)
                                        ? "Lựa chọn tiêu chuẩn"
                                        : selectionLabel)</td>
                                    <td>@item.Price.ToString("N0") ₫</td>
                                    <td>@item.CurrentPrice.ToString("N0") ₫</td>
                                    <td>@item.StockQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/products-details.css" asp-append-version="true" />
}
