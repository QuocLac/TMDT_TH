@model WebApplication2.Areas.Admin.ViewModels.Products.ProductCreateViewModel
@{
    ViewData["Title"] = "Tạo sản phẩm";
}

<section class="admin-page product-editor" data-product-create>
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Danh mục hàng hóa</p>
            <h2>Tạo sản phẩm mới</h2>
            <p class="admin-page-lead">
                Tạo thông tin chung trước, sau đó bổ sung các lựa chọn bán và thông tin riêng
                theo danh mục. Mã hàng được hệ thống cấp sau khi lưu.
            </p>
        </div>
        <a asp-action="Index" class="button button--secondary">Quay lại</a>
    </header>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data"
          class="product-editor-form"
          data-product-editor-form>
        <div asp-validation-summary="ModelOnly"
             class="admin-notice admin-notice--danger"></div>

        <section class="editor-card">
            <div class="editor-card__heading">
                <span class="step-index">01</span>
                <h3>Thông tin cơ bản</h3>
            </div>
            <div class="editor-grid">
                <label class="field field--wide">
                    Tên sản phẩm
                    <input asp-for="Name" data-product-name />
                    <span asp-validation-for="Name"></span>
                </label>
                <label class="field">
                    Đường dẫn SEO
                    <input asp-for="Slug" data-product-slug />
                    <span asp-validation-for="Slug"></span>
                </label>
                <label class="field">
                    Danh mục
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions">
                        <option value="">Chọn danh mục</option>
                    </select>
                    <span asp-validation-for="CategoryId"></span>
                </label>
                <label class="field">
                    Thương hiệu
                    <select asp-for="BrandId" asp-items="Model.BrandOptions"></select>
                </label>
                <label class="field field--wide">
                    Giới thiệu sản phẩm
                    <textarea asp-for="Description"
                              rows="5"
                              placeholder="Nội dung giúp khách hàng hiểu công dụng và điểm nổi bật"></textarea>
                </label>
                <label class="form-check field--check">
                    <input asp-for="IsActive" />
                    <span>Hiển thị sản phẩm sau khi tạo</span>
                </label>
            </div>
        </section>

        <section class="editor-card">
            <div class="editor-card__heading">
                <span class="step-index">02</span>
                <h3>Nội dung tìm kiếm</h3>
            </div>
            <div class="editor-grid">
                <label class="field">
                    Tiêu đề tìm kiếm
                    <input asp-for="MetaTitle" maxlength="255" />
                    <span asp-validation-for="MetaTitle"></span>
                </label>
                <label class="field">
                    Mô tả tìm kiếm
                    <textarea asp-for="MetaDescription"
                              rows="3"
                              maxlength="500"></textarea>
                    <span asp-validation-for="MetaDescription"></span>
                </label>
            </div>
        </section>

        <section class="editor-card">
            <div class="editor-card__heading">
                <span class="step-index">03</span>
                <h3>Hình ảnh</h3>
            </div>
            <div class="editor-grid">
                <label class="field">
                    Ảnh đại diện
                    <input asp-for="MainImage"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           required />
                    <span asp-validation-for="MainImage"></span>
                </label>
                <label class="field">
                    Ảnh bổ sung
                    <input asp-for="GalleryImages"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           multiple />
                </label>
            </div>
        </section>

        <section class="editor-card">
            <div class="editor-card__heading editor-card__heading--actions">
                <div>
                    <span class="step-index">04</span>
                    <div>
                        <h3>Các lựa chọn bán</h3>
                        <small>Mỗi lựa chọn có mã hàng, giá và số lượng bán riêng.</small>
                    </div>
                </div>
                <button type="button"
                        class="button button--secondary button--small"
                        data-add-create-variant>
                    Thêm lựa chọn
                </button>
            </div>

            <div class="variant-create-list" data-create-variant-list>
                @for (var index = 0; index < Model.Variants.Count; index++)
                {
                    <article class="variant-create-row" data-create-variant-row>
                        <span class="variant-create-row__number">@(index + 1)</span>
                        <label>
                            Màu sắc / phiên bản
                            <input asp-for="Variants[index].Color"
                                   data-variant-property="Color" />
                        </label>
                        <label>
                            Kích cỡ / dung lượng / quy cách
                            <input asp-for="Variants[index].Size"
                                   data-variant-property="Size" />
                        </label>
                        <label>
                            Giá niêm yết
                            <input asp-for="Variants[index].Price"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   data-variant-property="Price" />
                            <span asp-validation-for="Variants[index].Price"></span>
                        </label>
                        <label>
                            Số lượng có thể bán
                            <input asp-for="Variants[index].StockQuantity"
                                   type="number"
                                   min="0"
                                   data-variant-property="StockQuantity" />
                        </label>
                        <label>
                            Ảnh của lựa chọn
                            <input asp-for="Variants[index].Image"
                                   type="file"
                                   accept="image/jpeg,image/png,image/webp"
                                   data-variant-property="Image" />
                        </label>
                        <label class="form-check">
                            <input type="checkbox"
                                   name="Variants[@index].IsActive"
                                   value="true"
                                   checked="@Model.Variants[index].IsActive"
                                   data-variant-property="IsActive" />
                            <input type="hidden"
                                   name="Variants[@index].IsActive"
                                   value="false"
                                   data-variant-hidden="IsActive" />
                            <span>Cho phép bán</span>
                        </label>
                        <button type="button"
                                class="button button--danger button--small"
                                data-remove-create-variant>
                            Xóa
                        </button>
                    </article>
                }
            </div>
        </section>

        @if (Model.PromotionOptions.Count > 0)
        {
            <section class="editor-card">
                <div class="editor-card__heading">
                    <span class="step-index">05</span>
                    <h3>Chương trình giảm giá đang có</h3>
                </div>
                <div class="choice-grid">
                    @foreach (var option in Model.PromotionOptions)
                    {
                        <label class="choice-card">
                            <input type="checkbox"
                                   name="SelectedPromotionIds"
                                   value="@option.Value"
                                   checked="@option.Selected" />
                            <span>@option.Text</span>
                        </label>
                    }
                </div>
            </section>
        }

        <footer class="sticky-editor-actions">
            <span>
                Sau khi tạo, mở “Thông tin ngành hàng” để nhập thông số phù hợp với danh mục.
            </span>
            <div>
                <a asp-action="Index" class="button button--secondary">Hủy</a>
                <button class="button button--primary" type="submit">Tạo sản phẩm</button>
            </div>
        </footer>
    </form>

    <template data-create-variant-template>
        <article class="variant-create-row" data-create-variant-row>
            <span class="variant-create-row__number"></span>
            <label>
                Màu sắc / phiên bản
                <input data-variant-property="Color" />
            </label>
            <label>
                Kích cỡ / dung lượng / quy cách
                <input data-variant-property="Size" />
            </label>
            <label>
                Giá niêm yết
                <input type="number"
                       min="0.01"
                       step="0.01"
                       data-variant-property="Price" />
            </label>
            <label>
                Số lượng có thể bán
                <input type="number"
                       min="0"
                       data-variant-property="StockQuantity" />
            </label>
            <label>
                Ảnh của lựa chọn
                <input type="file"
                       accept="image/jpeg,image/png,image/webp"
                       data-variant-property="Image" />
            </label>
            <label class="form-check">
                <input type="checkbox"
                       value="true"
                       checked
                       data-variant-property="IsActive" />
                <input type="hidden"
                       value="false"
                       data-variant-hidden="IsActive" />
                <span>Cho phép bán</span>
            </label>
            <button type="button"
                    class="button button--danger button--small"
                    data-remove-create-variant>
                Xóa
            </button>
        </article>
    </template>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/products-editor.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/admin/products-editor.js" asp-append-version="true"></script>
}
