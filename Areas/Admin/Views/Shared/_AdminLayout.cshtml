@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using System.Security.Claims
@{
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var requestedEventTheme = ViewData["EventTheme"]?.ToString();
    var eventTheme = string.Equals(requestedEventTheme, "tet", StringComparison.OrdinalIgnoreCase)
        ? "tet"
        : "default";
    var displayName = User.Identity?.Name ?? "Quản trị viên";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "A"
        : displayName.Trim()[0].ToString().ToUpperInvariant();

    string ActiveClass(params string[] controllers) =>
        controllers.Contains(currentController, StringComparer.OrdinalIgnoreCase)
            ? "is-active"
            : string.Empty;

    string CommercializeMessage(string value) =>
        value
            .Replace("Biến thể", "Lựa chọn bán", StringComparison.OrdinalIgnoreCase)
            .Replace("biến thể", "lựa chọn bán", StringComparison.OrdinalIgnoreCase)
            .Replace("Inbound", "Nhập vào kho", StringComparison.OrdinalIgnoreCase)
            .Replace("inbound", "nhập vào kho", StringComparison.OrdinalIgnoreCase)
            .Replace("Outbound", "Giao tới khách hàng", StringComparison.OrdinalIgnoreCase)
            .Replace("outbound", "giao tới khách hàng", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi" data-theme="light" data-event-theme="@eventTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#17210f" />
    <meta name="request-verification-token" content="@antiforgeryTokens.RequestToken" />
    <title>@ViewData["Title"] - FastBuy Admin</title>
    <script src="~/js/layouts/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <a class="skip-link" href="#admin-main-content">Đi đến nội dung chính</a>

    <div class="admin-shell">
        <aside id="admin-sidebar" class="admin-sidebar" aria-label="Điều hướng quản trị">
            <a asp-area="Admin"
               asp-controller="Home"
               asp-action="Index"
               class="admin-brand"
               aria-label="FastBuy Admin - Tổng quan">
                <span class="admin-brand__mark" aria-hidden="true">FB</span>
                <span>
                    <strong>FastBuy</strong>
                    <small>Trung tâm vận hành</small>
                </span>
            </a>

            <nav class="admin-nav">
                <p class="admin-nav__label">Tổng quan</p>
                <a asp-area="Admin"
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Home")"
                   aria-current="@(currentController == "Home" ? "page" : null)">
                    <span>Tổng quan vận hành</span>
                </a>

                <p class="admin-nav__label">Bán hàng</p>
                <a asp-area="Admin"
                   asp-controller="Orders"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Orders")"
                   aria-current="@(currentController == "Orders" ? "page" : null)">
                    <span>Xử lý đơn hàng</span>
                </a>

                <p class="admin-nav__label">Hàng hóa</p>
                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Products")"
                   aria-current="@(currentController == "Products" ? "page" : null)">
                    <span>Quản lý sản phẩm</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="ProductOptions"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("ProductOptions")"
                   aria-current="@(currentController == "ProductOptions" ? "page" : null)">
                    <span>Lựa chọn mua theo sản phẩm</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Categories")"
                   aria-current="@(currentController == "Categories" ? "page" : null)">
                    <span>Danh mục sản phẩm</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="ProductInformation"
                   asp-action="Definitions"
                   class="admin-nav__link @ActiveClass("ProductInformation")"
                   aria-current="@(currentController == "ProductInformation" ? "page" : null)">
                    <span>Thông tin theo ngành hàng</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="CatalogReadiness"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("CatalogReadiness")"
                   aria-current="@(currentController == "CatalogReadiness" ? "page" : null)">
                    <span>Chất lượng dữ liệu sản phẩm</span>
                </a>

                <p class="admin-nav__label">Vận hành sau bán</p>
                <a asp-area="Admin"
                   asp-controller="Shipping"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Shipping")"
                   aria-current="@(currentController == "Shipping" ? "page" : null)">
                    <span>Giao vận</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="Returns"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Returns")"
                   aria-current="@(currentController == "Returns" ? "page" : null)">
                    <span>Hoàn trả và kiểm định</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="Reviews"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("Reviews")"
                   aria-current="@(currentController == "Reviews" ? "page" : null)">
                    <span>Đánh giá sản phẩm</span>
                </a>

                <p class="admin-nav__label">Giá bán</p>
                <a asp-area="Admin"
                   asp-controller="PriceCampaigns"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("PriceCampaigns")"
                   aria-current="@(currentController == "PriceCampaigns" ? "page" : null)">
                    <span>Lịch áp dụng giá</span>
                </a>
                <a asp-area="Admin"
                   asp-controller="PriceHistories"
                   asp-action="Index"
                   class="admin-nav__link @ActiveClass("PriceHistories")"
                   aria-current="@(currentController == "PriceHistories" ? "page" : null)">
                    <span>Nhật ký biến động giá</span>
                </a>
            </nav>

            <div class="admin-sidebar__footer">
                <div>
                    <strong>Trạng thái hệ thống</strong>
                    <small>Đơn hàng, thanh toán và giao vận đang được giám sát</small>
                </div>
            </div>
        </aside>

        <button type="button"
                class="admin-sidebar-overlay"
                data-admin-sidebar-dismiss
                aria-label="Đóng menu quản trị"
                tabindex="-1"></button>

        <div class="admin-workspace">
            <header class="admin-topbar">
                <div class="admin-topbar__title">
                    <button type="button"
                            class="admin-menu-toggle"
                            data-admin-sidebar-toggle
                            aria-controls="admin-sidebar"
                            aria-expanded="false">
                        Menu
                    </button>
                    <div>
                        <small>FastBuy Admin</small>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                <form asp-area="Admin"
                      asp-controller="Orders"
                      asp-action="Index"
                      method="get"
                      class="admin-global-search"
                      role="search">
                    <label class="visually-hidden" for="admin-global-search-input">
                        Tìm đơn hàng
                    </label>
                    <input id="admin-global-search-input"
                           name="Search"
                           type="search"
                           maxlength="100"
                           placeholder="Tìm mã đơn, khách hàng hoặc số điện thoại"
                           autocomplete="off" />
                    <button type="submit">Tìm</button>
                </form>

                <div class="admin-topbar__actions">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="admin-text-action">
                        Mở cửa hàng
                    </a>

                    <button type="button"
                            class="admin-text-action theme-toggle"
                            data-theme-toggle
                            aria-pressed="false">
                        <span data-theme-label>Giao diện tối</span>
                    </button>

                    <details class="admin-account-menu">
                        <summary>
                            <span class="admin-account-menu__avatar" aria-hidden="true">@initial</span>
                            <span class="admin-account-menu__copy">
                                <strong>@displayName</strong>
                                <small>Quản trị viên</small>
                            </span>
                        </summary>
                        <div class="admin-account-menu__panel">
                            <div class="admin-account-menu__identity">
                                <strong>@displayName</strong>
                                @if (!string.IsNullOrWhiteSpace(email))
                                {
                                    <span>@email</span>
                                }
                            </div>
                            <a asp-area=""
                               asp-controller="Account"
                               asp-action="Profile">
                                Hồ sơ tài khoản
                            </a>
                            <form asp-area=""
                                  asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit">Đăng xuất</button>
                            </form>
                        </div>
                    </details>
                </div>
            </header>

            <main id="admin-main-content" class="admin-main" tabindex="-1">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="admin-notice admin-notice--success" role="status">
                        <span>@CommercializeMessage(successMessage)</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="admin-notice admin-notice--danger" role="alert">
                        <span>@CommercializeMessage(errorMessage)</span>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/core/http.js" asp-append-version="true"></script>
    <script src="~/js/core/pricing-confirmation-integrity.js" asp-append-version="true"></script>
    <script src="~/js/layouts/admin-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
