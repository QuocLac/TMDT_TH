@using System.Globalization
@using WebApplication2.Areas.Admin.ViewModels.Orders
@using WebApplication2.Models.Enums
@model OrderAdminIndexPageViewModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var fromDateValue = Model.FromDate?.ToString("yyyy-MM-dd");
    var toDateValue = Model.ToDate?.ToString("yyyy-MM-dd");
}

<section class="admin-page orders-page" data-orders-page>
    <header class="admin-page-header">
        <div>
            <p class="eyebrow">Order operations</p>
            <h2>Quản lý đơn hàng</h2>
            <p class="admin-page-lead">
                Theo dõi đơn, thanh toán, chuẩn bị hàng và vận chuyển bằng state machine có kiểm soát concurrency.
            </p>
        </div>
    </header>

    <div class="metric-grid metric-grid--five" aria-label="Tổng quan đơn hàng">
        <article class="metric-card">
            <span>Tổng đơn</span>
            <strong>@Model.Summary.TotalOrders</strong>
        </article>
        <article class="metric-card">
            <span>Chờ xác nhận</span>
            <strong>@Model.Summary.PendingConfirmation</strong>
        </article>
        <article class="metric-card">
            <span>Đang xử lý</span>
            <strong>@Model.Summary.Processing</strong>
        </article>
        <article class="metric-card">
            <span>Sẵn sàng giao</span>
            <strong>@Model.Summary.ReadyToShip</strong>
        </article>
        <article class="metric-card metric-card--danger">
            <span>Giao thất bại</span>
            <strong>@Model.Summary.DeliveryFailed</strong>
        </article>
    </div>

    <section class="data-panel order-filter-panel" aria-labelledby="order-filter-heading">
        <div class="order-filter-heading">
            <div>
                <p class="eyebrow">Bộ lọc vận hành</p>
                <h3 id="order-filter-heading">Tìm và phân loại đơn</h3>
            </div>
            <span>@Model.TotalItems kết quả</span>
        </div>

        <form method="get" asp-action="Index" class="order-filter-grid">
            <label class="order-filter-field order-filter-field--search">
                <span>Tìm kiếm</span>
                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       maxlength="100"
                       placeholder="Mã đơn, tên, số điện thoại, tracking..." />
            </label>

            <label class="order-filter-field">
                <span>Trạng thái đơn</span>
                <select name="OrderStatus">
                    <option value="">Tất cả</option>
                    @foreach (var status in Enum.GetValues<OrderStatus>())
                    {
                        if (Model.OrderStatus == status)
                        {
                            <option value="@status" selected>@OrderAdminDisplay.OrderStatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@OrderAdminDisplay.OrderStatusText(status)</option>
                        }
                    }
                </select>
            </label>

            <label class="order-filter-field">
                <span>Thanh toán</span>
                <select name="PaymentStatus">
                    <option value="">Tất cả</option>
                    @foreach (var status in Enum.GetValues<PaymentStatus>())
                    {
                        if (Model.PaymentStatus == status)
                        {
                            <option value="@status" selected>@OrderAdminDisplay.PaymentStatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@OrderAdminDisplay.PaymentStatusText(status)</option>
                        }
                    }
                </select>
            </label>

            <label class="order-filter-field">
                <span>Xử lý hàng</span>
                <select name="FulfillmentStatus">
                    <option value="">Tất cả</option>
                    @foreach (var status in Enum.GetValues<FulfillmentStatus>())
                    {
                        if (Model.FulfillmentStatus == status)
                        {
                            <option value="@status" selected>@OrderAdminDisplay.FulfillmentStatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@OrderAdminDisplay.FulfillmentStatusText(status)</option>
                        }
                    }
                </select>
            </label>

            <label class="order-filter-field">
                <span>Provider</span>
                <select name="Provider">
                    <option value="">Tất cả</option>
                    @foreach (var provider in Model.Providers)
                    {
                        if (string.Equals(Model.Provider, provider, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@provider" selected>@provider</option>
                        }
                        else
                        {
                            <option value="@provider">@provider</option>
                        }
                    }
                </select>
            </label>

            <label class="order-filter-field">
                <span>Từ ngày</span>
                <input type="date" name="FromDate" value="@fromDateValue" />
            </label>

            <label class="order-filter-field">
                <span>Đến ngày</span>
                <input type="date" name="ToDate" value="@toDateValue" />
            </label>

            <div class="order-filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    Áp dụng
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </section>

    <div class="data-panel order-table-panel">
        <div class="table-responsive">
            <table class="table align-middle order-table">
                <thead>
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái</th>
                        <th>Vận chuyển</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state compact">
                                    <strong>Không tìm thấy đơn hàng</strong>
                                    <span>Thử thay đổi từ khóa hoặc bộ lọc.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong class="order-code">@item.Code</strong>
                                    <small>
                                        Tạo @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <strong>@item.CustomerName</strong>
                                    <small>@item.CustomerPhone</small>
                                </td>
                                <td>
                                    <div class="order-status-stack">
                                        <span class="order-status order-status--@OrderAdminDisplay.CssToken(item.OrderStatus)">
                                            @OrderAdminDisplay.OrderStatusText(item.OrderStatus)
                                        </span>
                                        <span class="order-status order-status--@OrderAdminDisplay.CssToken(item.PaymentStatus)">
                                            @OrderAdminDisplay.PaymentStatusText(item.PaymentStatus)
                                        </span>
                                        <span class="order-status order-status--@OrderAdminDisplay.CssToken(item.FulfillmentStatus)">
                                            @OrderAdminDisplay.FulfillmentStatusText(item.FulfillmentStatus)
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <strong>@(item.Provider ?? "Chưa có")</strong>
                                    <small>@(item.TrackingCode ?? "Chưa có tracking")</small>
                                </td>
                                <td class="text-end">
                                    <strong>@item.GrandTotal.ToString("N0", culture) ₫</strong>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="order-pagination" aria-label="Phân trang đơn hàng">
            <a asp-action="Index"
               asp-route-page="@(Model.Page - 1)"
               asp-route-search="@Model.Search"
               asp-route-orderStatus="@Model.OrderStatus"
               asp-route-paymentStatus="@Model.PaymentStatus"
               asp-route-fulfillmentStatus="@Model.FulfillmentStatus"
               asp-route-provider="@Model.Provider"
               asp-route-fromDate="@fromDateValue"
               asp-route-toDate="@toDateValue"
               class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : null)"
               aria-disabled="@(Model.Page <= 1)">
                Trang trước
            </a>
            <span>Trang @Model.Page / @Model.TotalPages</span>
            <a asp-action="Index"
               asp-route-page="@(Model.Page + 1)"
               asp-route-search="@Model.Search"
               asp-route-orderStatus="@Model.OrderStatus"
               asp-route-paymentStatus="@Model.PaymentStatus"
               asp-route-fulfillmentStatus="@Model.FulfillmentStatus"
               asp-route-provider="@Model.Provider"
               asp-route-fromDate="@fromDateValue"
               asp-route-toDate="@toDateValue"
               class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : null)"
               aria-disabled="@(Model.Page >= Model.TotalPages)">
                Trang sau
            </a>
        </nav>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/orders.css" asp-append-version="true" />
}
