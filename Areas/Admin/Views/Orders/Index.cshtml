@using System.Globalization
@using WebApplication2.Areas.Admin.Presentation
@using WebApplication2.Areas.Admin.ViewModels.Orders
@using WebApplication2.Models.Enums
@model OrderAdminIndexPageViewModel

@{
    ViewData["Title"] = "Xử lý đơn hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var fromDateValue = Model.FromDate?.ToString("yyyy-MM-dd");
    var toDateValue = Model.ToDate?.ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/orders.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/orders-v2.css" asp-append-version="true" />
}

<section class="admin-page orders-page" data-orders-page>
    <header class="admin-page-header admin-page-header--hero">
        <div class="admin-page-header__copy">
            <p class="admin-page-kicker">Trung tâm bán hàng</p>
            <h2>Theo dõi đơn hàng theo từng giai đoạn</h2>
            <p class="admin-page-lead">
                Kiểm tra thanh toán, chuẩn bị hàng và tiến trình giao nhận
                trong một luồng rõ ràng, tập trung vào thao tác vận hành.
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a asp-area="Admin"
               asp-controller="Shipping"
               asp-action="Index"
               class="button button--secondary">
                Mở giao vận
            </a>
            <a asp-action="Index"
               asp-route-orderStatus="Placed"
               class="button button--primary">
                Đơn chờ xác nhận
            </a>
        </div>
    </header>

    <section class="admin-metric-grid admin-metric-grid--five" aria-label="Tổng quan đơn hàng">
        <article class="admin-metric-card admin-metric-card--info">
            <div><span class="admin-metric-card__label">Tổng đơn</span><strong class="admin-metric-card__value">@Model.Summary.TotalOrders</strong><small class="admin-metric-card__meta">Trong phạm vi hiện tại</small></div>
        </article>
        <article class="admin-metric-card admin-metric-card--warning">
            <div><span class="admin-metric-card__label">Chờ xác nhận</span><strong class="admin-metric-card__value">@Model.Summary.PendingConfirmation</strong><small class="admin-metric-card__meta">Cần kiểm tra thông tin đơn</small></div>
        </article>
        <article class="admin-metric-card admin-metric-card--info">
            <div><span class="admin-metric-card__label">Đang chuẩn bị</span><strong class="admin-metric-card__value">@Model.Summary.Processing</strong><small class="admin-metric-card__meta">Đang xử lý tại kho</small></div>
        </article>
        <article class="admin-metric-card admin-metric-card--success">
            <div><span class="admin-metric-card__label">Sẵn sàng giao</span><strong class="admin-metric-card__value">@Model.Summary.ReadyToShip</strong><small class="admin-metric-card__meta">Có thể bàn giao giao hàng</small></div>
        </article>
        <article class="admin-metric-card admin-metric-card--danger">
            <div><span class="admin-metric-card__label">Giao chưa thành công</span><strong class="admin-metric-card__value">@Model.Summary.DeliveryFailed</strong><small class="admin-metric-card__meta">Cần sắp xếp giao lại</small></div>
        </article>
    </section>

    <section class="admin-filter-panel" aria-labelledby="order-filter-heading">
        <div class="admin-filter-panel__header">
            <div>
                <p class="admin-page-kicker">Bộ lọc</p>
                <h3 id="order-filter-heading">Tìm và phân loại đơn</h3>
            </div>
            <span>@Model.TotalItems kết quả</span>
        </div>

        <form method="get" asp-action="Index" class="admin-filter-grid order-filter-grid">
            <label class="admin-filter-field admin-filter-field--wide">
                <span>Tìm kiếm</span>
                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       maxlength="100"
                       placeholder="Mã đơn, khách hàng, số điện thoại hoặc mã giao hàng" />
            </label>

            <label class="admin-filter-field">
                <span>Trạng thái đơn</span>
                <select name="OrderStatus">
                    <option value="">Tất cả</option>
                    @foreach (var status in Enum.GetValues<OrderStatus>())
                    {
                        if (Model.OrderStatus == status)
                        {
                            <option value="@status" selected>@AdminCommerceDisplay.OrderStatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@AdminCommerceDisplay.OrderStatusText(status)</option>
                        }
                    }
                </select>
            </label>

            <label class="admin-filter-field">
                <span>Thanh toán</span>
                <select name="PaymentStatus">
                    <option value="">Tất cả</option>
                    @foreach (var status in Enum.GetValues<PaymentStatus>())
                    {
                        if (Model.PaymentStatus == status)
                        {
                            <option value="@status" selected>@AdminCommerceDisplay.PaymentStatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@AdminCommerceDisplay.PaymentStatusText(status)</option>
                        }
                    }
                </select>
            </label>

            <label class="admin-filter-field">
                <span>Chuẩn bị và giao hàng</span>
                <select name="FulfillmentStatus">
                    <option value="">Tất cả</option>
                    @foreach (var status in Enum.GetValues<FulfillmentStatus>())
                    {
                        if (Model.FulfillmentStatus == status)
                        {
                            <option value="@status" selected>@AdminCommerceDisplay.FulfillmentStatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@AdminCommerceDisplay.FulfillmentStatusText(status)</option>
                        }
                    }
                </select>
            </label>

            <label class="admin-filter-field">
                <span>Từ ngày</span>
                <input type="date" name="FromDate" value="@fromDateValue" />
            </label>

            <label class="admin-filter-field">
                <span>Đến ngày</span>
                <input type="date" name="ToDate" value="@toDateValue" />
            </label>

            <div class="admin-filter-actions">
                <button type="submit" class="button button--primary">Áp dụng</button>
                <a asp-action="Index" class="button button--secondary">Xóa lọc</a>
            </div>
        </form>
    </section>

    <section class="admin-panel">
        <header class="admin-panel__header">
            <div>
                <p class="admin-page-kicker">Danh sách đơn</p>
                <h3>Kết quả vận hành</h3>
                <p>Mở đơn để xem sản phẩm, thanh toán và tiến trình giao nhận.</p>
            </div>
            <span class="admin-badge admin-badge--neutral">Trang @Model.Page / @Math.Max(Model.TotalPages, 1)</span>
        </header>

        <div class="admin-table-wrap">
            <table class="admin-data-table order-table">
                <thead>
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái đơn</th>
                        <th>Thanh toán</th>
                        <th>Giao hàng</th>
                        <th class="u-text-end">Tổng tiền</th>
                        <th class="u-text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="7"><div class="admin-empty-state admin-empty-state--compact"><div><strong>Không tìm thấy đơn hàng</strong><span>Hãy thay đổi từ khóa hoặc phạm vi bộ lọc.</span></div></div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><span class="admin-cell-primary order-code">@item.Code</span><span class="admin-cell-secondary">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>
                                <td><span class="admin-cell-primary">@item.CustomerName</span><span class="admin-cell-secondary">@item.CustomerPhone</span></td>
                                <td><span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(item.OrderStatus)">@AdminCommerceDisplay.OrderStatusText(item.OrderStatus)</span></td>
                                <td><span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(item.PaymentStatus)">@AdminCommerceDisplay.PaymentStatusText(item.PaymentStatus)</span></td>
                                <td>
                                    <span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(item.FulfillmentStatus)">@AdminCommerceDisplay.FulfillmentStatusText(item.FulfillmentStatus)</span>
                                    @if (!string.IsNullOrWhiteSpace(item.TrackingCode))
                                    {
                                        <span class="admin-cell-secondary">@item.TrackingCode</span>
                                    }
                                </td>
                                <td class="u-text-end"><span class="admin-cell-money">@item.GrandTotal.ToString("N0", culture) ₫</span></td>
                                <td class="u-text-end"><a asp-action="Details" asp-route-id="@item.Id" class="admin-row-text-action">Xử lý đơn</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pagination" aria-label="Phân trang đơn hàng">
            <a asp-action="Index"
               asp-route-page="@(Model.Page - 1)"
               asp-route-search="@Model.Search"
               asp-route-orderStatus="@Model.OrderStatus"
               asp-route-paymentStatus="@Model.PaymentStatus"
               asp-route-fulfillmentStatus="@Model.FulfillmentStatus"
               asp-route-fromDate="@fromDateValue"
               asp-route-toDate="@toDateValue"
               class="button button--secondary @(Model.Page <= 1 ? "disabled" : null)"
               aria-disabled="@(Model.Page <= 1)">Trang trước</a>
            <span>Trang @Model.Page trên @Model.TotalPages</span>
            <a asp-action="Index"
               asp-route-page="@(Model.Page + 1)"
               asp-route-search="@Model.Search"
               asp-route-orderStatus="@Model.OrderStatus"
               asp-route-paymentStatus="@Model.PaymentStatus"
               asp-route-fulfillmentStatus="@Model.FulfillmentStatus"
               asp-route-fromDate="@fromDateValue"
               asp-route-toDate="@toDateValue"
               class="button button--secondary @(Model.Page >= Model.TotalPages ? "disabled" : null)"
               aria-disabled="@(Model.Page >= Model.TotalPages)">Trang sau</a>
        </nav>
    }
</section>
