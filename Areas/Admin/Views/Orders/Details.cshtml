@using System.Globalization
@using WebApplication2.Areas.Admin.Presentation
@using WebApplication2.Areas.Admin.ViewModels.Orders
@using WebApplication2.Models.Enums
@using WebApplication2.Services.Shipping.Internal
@model OrderAdminDetailsViewModel

@{
    ViewData["Title"] = $"Đơn hàng {Model.Code}";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var outboundShipments = Model.Shipments
        .Where(item => !string.Equals(item.ServiceCode, "RETURN", StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var operationalTargets = Model.AllowedOrderTransitions
        .Where(item => item is OrderStatus.Confirmed or OrderStatus.Processing)
        .ToArray();
    var progressPosition = Model.FulfillmentStatus switch
    {
        FulfillmentStatus.Preparing => 2,
        FulfillmentStatus.ReadyToShip => 3,
        FulfillmentStatus.Shipped or FulfillmentStatus.DeliveryFailed => 4,
        FulfillmentStatus.Delivered => 5,
        _ when Model.OrderStatus is OrderStatus.Confirmed or OrderStatus.Processing => 2,
        _ when Model.OrderStatus is OrderStatus.Completed or OrderStatus.Closed => 5,
        _ => 1
    };
    var progressSteps = new[]
    {
        (1, "Đã ghi nhận", "Đơn hàng đã được tạo."),
        (2, "Xác nhận", "Kiểm tra thanh toán và thông tin nhận hàng."),
        (3, "Chuẩn bị", "Kiểm tra, đóng gói sản phẩm."),
        (4, "Đang giao", "Đơn đang được giao đến khách hàng."),
        (5, "Hoàn tất", "Khách hàng đã nhận được đơn.")
    };

    string PaymentMethodText(string method) => method.ToUpperInvariant() switch
    {
        "COD" => "Thanh toán khi nhận hàng",
        "VNPAY" => "Thanh toán trực tuyến",
        "REFUND" => "Hoàn tiền",
        _ => "Thanh toán"
    };

    string TransitionLabel(OrderStatus status) => status switch
    {
        OrderStatus.Confirmed => "Xác nhận đơn hàng",
        OrderStatus.Processing => "Chuyển sang chuẩn bị hàng",
        _ => "Cập nhật đơn hàng"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/orders.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/orders-v2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/order-commercial.css" asp-append-version="true" />
}

<section class="admin-page orders-page order-details-page order-commercial-page">
    <header class="admin-page-header order-details-header">
        <div>
            <p class="admin-page-kicker">Chi tiết đơn hàng</p>
            <h2>@Model.Code</h2>
            <p class="admin-page-lead">Tạo lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="order-header-actions">
            <a asp-action="Index" class="button button--secondary">Danh sách đơn</a>
            <a asp-area="" asp-controller="Checkout" asp-action="Success" asp-route-publicToken="@Model.PublicToken" target="_blank" rel="noopener noreferrer" class="button button--secondary">Xem phía khách hàng</a>
        </div>
    </header>

    <div class="order-state-grid" aria-label="Trạng thái hiện tại">
        <article class="order-state-card"><span>Đơn hàng</span><strong class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(Model.OrderStatus)">@AdminCommerceDisplay.OrderStatusText(Model.OrderStatus)</strong></article>
        <article class="order-state-card"><span>Thanh toán</span><strong class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(Model.PaymentStatus)">@AdminCommerceDisplay.PaymentStatusText(Model.PaymentStatus)</strong></article>
        <article class="order-state-card"><span>Chuẩn bị và giao hàng</span><strong class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(Model.FulfillmentStatus)">@AdminCommerceDisplay.FulfillmentStatusText(Model.FulfillmentStatus)</strong></article>
        <article class="order-state-card order-state-card--money"><span>Tổng thanh toán</span><strong>@Model.GrandTotal.ToString("N0", culture) ₫</strong></article>
    </div>

    <section class="order-commercial-progress" aria-label="Tiến trình đơn hàng">
        @foreach (var step in progressSteps)
        {
            <article class="@(step.Item1 < progressPosition ? "is-complete" : step.Item1 == progressPosition ? "is-current" : null)">
                <span>@(step.Item1 < progressPosition ? "✓" : step.Item1)</span>
                <div><strong>@step.Item2</strong><small>@step.Item3</small></div>
            </article>
        }
    </section>

    <div class="order-details-layout">
        <div class="order-details-main">
            <section class="admin-panel order-section">
                <header class="order-section-heading"><div><p class="admin-page-kicker">Sản phẩm</p><h3>Sản phẩm trong đơn</h3></div><span>@Model.Items.Sum(item => item.Quantity) sản phẩm</span></header>
                <div class="admin-table-wrap">
                    <table class="admin-data-table order-detail-table">
                        <thead><tr><th>Sản phẩm</th><th>SKU</th><th class="u-text-center">Số lượng</th><th class="u-text-end">Đơn giá</th><th class="u-text-end">Thành tiền</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><div class="order-product-cell"><img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)" alt="" width="52" height="52" /><div><strong>@item.ProductName</strong><small>@item.VariantDescription</small></div></div></td>
                                    <td>@item.Sku</td><td class="u-text-center">@item.Quantity</td><td class="u-text-end">@item.UnitPrice.ToString("N0", culture) ₫</td><td class="u-text-end"><strong>@item.LineTotal.ToString("N0", culture) ₫</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <dl class="order-money-summary">
                    <div><dt>Tạm tính</dt><dd>@Model.Subtotal.ToString("N0", culture) ₫</dd></div>
                    <div><dt>Phí giao hàng</dt><dd>@Model.ShippingFee.ToString("N0", culture) ₫</dd></div>
                    @if (Model.DiscountTotal > 0)
                    {
                        <div><dt>Giảm giá</dt><dd>-@Model.DiscountTotal.ToString("N0", culture) ₫</dd></div>
                    }
                    @if (Model.TaxTotal > 0)
                    {
                        <div><dt>Thuế</dt><dd>@Model.TaxTotal.ToString("N0", culture) ₫</dd></div>
                    }
                    <div class="order-money-summary__grand"><dt>Tổng thanh toán</dt><dd>@Model.GrandTotal.ToString("N0", culture) ₫</dd></div>
                </dl>
            </section>

            <section class="admin-panel order-section">
                <header class="order-section-heading"><div><p class="admin-page-kicker">Thanh toán</p><h3>Lịch sử thanh toán</h3></div></header>
                <div class="order-commercial-payment-list">
                    @if (Model.Payments.Count == 0)
                    {
                        <p>Chưa có thông tin thanh toán.</p>
                    }
                    else
                    {
                        @foreach (var payment in Model.Payments.Where(item => item.Amount > 0))
                        {
                            <article>
                                <div><strong>@PaymentMethodText(payment.Method)</strong><small>@payment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
                                <span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(payment.Status)">@AdminCommerceDisplay.PaymentStatusText(payment.Status)</span>
                                <b>@payment.Amount.ToString("N0", culture) ₫</b>
                            </article>
                        }
                    }
                </div>
            </section>

            <section class="admin-panel order-section">
                <header class="order-section-heading"><div><p class="admin-page-kicker">Giao vận</p><h3>Tiến trình giao hàng</h3></div><a asp-area="Admin" asp-controller="Shipping" asp-action="Index" asp-route-search="@Model.Code" class="button button--secondary button--small">Mở trung tâm giao vận</a></header>
                @if (outboundShipments.Length == 0)
                {
                    <div class="admin-empty-state admin-empty-state--compact"><div><strong>Chưa có hồ sơ giao hàng</strong><span>Hồ sơ sẽ được hiển thị khi đơn sẵn sàng xử lý.</span></div></div>
                }
                else
                {
                    <div class="order-shipment-grid">
                        @foreach (var shipment in outboundShipments)
                        {
                            <article class="order-shipment-card">
                                <header><div><strong>@(shipment.TrackingCode ?? "Chưa cấp mã theo dõi")</strong><small>@(shipment.ServiceName ?? "Giao hàng tiêu chuẩn")</small></div><span class="admin-badge admin-badge--@AdminCommerceDisplay.Tone(shipment.Status)">@InternalShippingLifecycleService.StatusTitle(shipment.Status)</span></header>
                                <dl><div><dt>Phí giao hàng</dt><dd>@shipment.Fee.ToString("N0", culture) ₫</dd></div><div><dt>Thu khi nhận</dt><dd>@shipment.CodAmount.ToString("N0", culture) ₫</dd></div><div><dt>Dự kiến giao</dt><dd>@(shipment.EstimatedDeliveryAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Chưa xác định")</dd></div></dl>
                                <a asp-area="Admin" asp-controller="Shipping" asp-action="Details" asp-route-id="@shipment.Id" class="admin-row-text-action">Cập nhật giao hàng</a>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="admin-panel order-section">
                <header class="order-section-heading"><div><p class="admin-page-kicker">Lịch sử</p><h3>Diễn biến đơn hàng</h3></div></header>
                <ol class="order-timeline">
                    @foreach (var item in Model.Timeline.Where(item => item.CustomerVisible).OrderByDescending(item => item.OccurredAt))
                    {
                        <li>
                            <span class="order-timeline__dot" aria-hidden="true"></span>
                            <div>
                                <header>
                                    <strong>@item.Title</strong>
                                    <span>@item.OccurredAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                </header>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p>@item.Description</p>
                                }
                                <small>@item.ChangedBy</small>
                            </div>
                        </li>
                    }
                </ol>
            </section>
        </div>

        <aside class="order-details-side">
            <section class="admin-panel order-section order-customer-card">
                <header class="order-section-heading"><div><p class="admin-page-kicker">Khách hàng</p><h3>Thông tin nhận hàng</h3></div></header>
                <dl><div><dt>Khách hàng</dt><dd>@Model.CustomerName</dd></div><div><dt>Email</dt><dd>@Model.CustomerEmail</dd></div><div><dt>Điện thoại</dt><dd>@Model.CustomerPhone</dd></div><div><dt>Địa chỉ</dt><dd>@Model.ShippingAddress</dd></div></dl>
            </section>

            @if (operationalTargets.Length > 0)
            {
                <section class="admin-panel order-section order-commercial-actions">
                    <header class="order-section-heading"><div><p class="admin-page-kicker">Thao tác</p><h3>Bước xử lý tiếp theo</h3></div></header>
                    @foreach (var target in operationalTargets)
                    {
                        <form asp-action="ChangeOrderStatus" asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                            <input type="hidden" name="TargetStatus" value="@target" />
                            <label><span>Ghi chú xử lý</span><textarea name="Reason" minlength="3" maxlength="500" rows="3" required placeholder="Nêu ngắn gọn căn cứ xác nhận"></textarea></label>
                            <button type="submit" class="button button--primary">@TransitionLabel(target)</button>
                        </form>
                    }
                </section>
            }

            <section class="order-safety-note">
                Hủy đơn được xử lý qua yêu cầu hủy toàn bộ đơn để bảo toàn thanh toán và tồn kho.
                Hoàn trả được tiếp nhận sau khi giao thành công và đi qua kiểm tra trước khi hoàn tiền.
                <a asp-area="Admin" asp-controller="Returns" asp-action="Index" asp-route-search="@Model.Code">Xem yêu cầu hoàn trả</a>
            </section>
        </aside>
    </div>
</section>
