@model WebApplication2.Areas.Admin.ViewModels.CatalogReadiness.CatalogReadinessPageViewModel
@{
    ViewData["Title"] = "Chất lượng dữ liệu sản phẩm";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/catalog-readiness.css"
          asp-append-version="true" />
}

<section class="admin-page catalog-readiness-page">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Kiểm soát danh mục hàng hóa</p>
            <h2>Chất lượng dữ liệu sản phẩm</h2>
            <p class="admin-page-lead">
                Phát hiện sản phẩm thiếu ảnh, thiếu mã hàng có thể bán, thiếu lựa chọn
                bắt buộc hoặc thiếu thông tin theo ngành hàng trước khi khách hàng nhìn thấy.
            </p>
        </div>
        <div class="admin-page-header__actions">
            <form asp-area="Admin"
                  asp-controller="CatalogPublishing"
                  asp-action="Reconcile"
                  method="post"
                  data-catalog-reconcile-form>
                <input type="hidden" name="Query" value="@Model.Query" />
                <input type="hidden" name="Status" value="@Model.Status" />
                <input type="hidden" name="Page" value="@Model.Page" />
                <input type="hidden" name="MaximumProducts" value="200" />
                <button type="submit"
                        class="button button--secondary"
                        data-confirm-message="Rà soát toàn bộ sản phẩm đang hiển thị theo từng lượt 200 sản phẩm và tự động ẩn sản phẩm không còn đủ điều kiện bán?">
                    Rà soát sản phẩm đang hiển thị
                </button>
            </form>
            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Create"
               class="button button--primary">
                Tạo sản phẩm
            </a>
        </div>
    </header>

    <section class="catalog-readiness-summary">
        <a asp-action="Index"
           asp-route-query="@Model.Query"
           class="catalog-readiness-summary__item @(Model.Status == "all" ? "is-active" : null)">
            <span>Tất cả</span>
            <strong>@Model.Summary.TotalProductCount</strong>
        </a>
        <a asp-action="Index"
           asp-route-query="@Model.Query"
           asp-route-status="ready"
           class="catalog-readiness-summary__item @(Model.Status == "ready" ? "is-active" : null)">
            <span>Sẵn sàng bán</span>
            <strong>@Model.Summary.ReadyCount</strong>
        </a>
        <a asp-action="Index"
           asp-route-query="@Model.Query"
           asp-route-status="attention"
           class="catalog-readiness-summary__item @(Model.Status == "attention" ? "is-active" : null)">
            <span>Cần hoàn thiện</span>
            <strong>@Model.Summary.AttentionCount</strong>
        </a>
        <a asp-action="Index"
           asp-route-query="@Model.Query"
           asp-route-status="unavailable"
           class="catalog-readiness-summary__item @(Model.Status == "unavailable" ? "is-active" : null)">
            <span>Chưa thể bán</span>
            <strong>@Model.Summary.UnavailableCount</strong>
        </a>
        <a asp-action="Index"
           asp-route-query="@Model.Query"
           asp-route-status="hidden"
           class="catalog-readiness-summary__item @(Model.Status == "hidden" ? "is-active" : null)">
            <span>Đang ẩn</span>
            <strong>@Model.Summary.HiddenCount</strong>
        </a>
    </section>

    <form method="get" class="admin-filter-panel catalog-readiness-filter">
        <input type="hidden" name="status" value="@Model.Status" />
        <label class="admin-filter-field">
            <span>Tìm sản phẩm</span>
            <input type="search"
                   name="query"
                   value="@Model.Query"
                   placeholder="Tên sản phẩm, đường dẫn hoặc mã hàng" />
        </label>
        <button type="submit" class="button button--primary">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <a asp-action="Index"
               asp-route-status="@Model.Status"
               class="button button--secondary">
                Xóa từ khóa
            </a>
        }
        <span>@Model.TotalItems kết quả</span>
    </form>

    <form id="catalog-publication-bulk-form"
          asp-area="Admin"
          asp-controller="CatalogPublishing"
          asp-action="Bulk"
          method="post"
          class="catalog-readiness-bulk">
        <input type="hidden" name="Query" value="@Model.Query" />
        <input type="hidden" name="Status" value="@Model.Status" />
        <input type="hidden" name="Page" value="@Model.Page" />
        <div>
            <strong>Thao tác với sản phẩm đã chọn</strong>
            <span>
                <strong data-catalog-selected-count>0</strong>
                sản phẩm được chọn · tối đa 100 sản phẩm mỗi lần.
            </span>
        </div>
        <label class="catalog-readiness-bulk__select-all">
            <input type="checkbox" data-catalog-select-all />
            <span>Chọn tất cả trên trang</span>
        </label>
        <button type="submit"
                name="Operation"
                value="publish"
                class="button button--primary"
                data-catalog-bulk-action
                data-confirm-message="Kiểm tra và hiển thị các sản phẩm đã chọn nếu đủ điều kiện?"
                disabled>
            Hiển thị sản phẩm đạt yêu cầu
        </button>
        <button type="submit"
                name="Operation"
                value="hide"
                class="button button--secondary"
                data-catalog-bulk-action
                data-confirm-message="Ẩn toàn bộ sản phẩm đã chọn khỏi cửa hàng?"
                disabled>
            Ẩn sản phẩm đã chọn
        </button>
    </form>

    <section class="catalog-readiness-list">
        @if (Model.Items.Count == 0)
        {
            <div class="admin-empty-state">
                <div>
                    <strong>Không có sản phẩm trong nhóm này</strong>
                    <span>Hãy đổi bộ lọc hoặc từ khóa tìm kiếm.</span>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <article class="catalog-readiness-card">
                    <header>
                        <label class="catalog-readiness-card__select">
                            <input type="checkbox"
                                   name="ProductIds"
                                   value="@item.ProductId"
                                   form="catalog-publication-bulk-form"
                                   data-catalog-product-select
                                   aria-label="Chọn @item.ProductName" />
                            <span>Chọn</span>
                        </label>
                        <img src="@item.ImageUrl"
                             alt=""
                             loading="lazy" />
                        <div>
                            <div class="catalog-readiness-card__title">
                                <h3>@item.ProductName</h3>
                                <span class="catalog-readiness-state catalog-readiness-state--@item.State">
                                    @item.StateLabel
                                </span>
                            </div>
                            <p>
                                @item.CategoryName ·
                                @(item.BrandName ?? "Không công bố thương hiệu")
                            </p>
                            <small>/products/@item.ProductSlug</small>
                        </div>
                    </header>

                    <div class="catalog-readiness-card__metrics">
                        <div>
                            <span>Mã hàng</span>
                            <strong>@item.ActiveItemCount / @item.ItemCount đang bán</strong>
                        </div>
                        <div>
                            <span>Còn số lượng bán</span>
                            <strong>@item.InStockItemCount</strong>
                        </div>
                        <div>
                            <span>Nhóm bắt buộc</span>
                            <strong>@item.RequiredOptionGroupCount</strong>
                        </div>
                        <div>
                            <span>Thông tin bắt buộc</span>
                            <strong>
                                @(item.RequiredInformationCount - item.MissingRequiredInformationCount)
                                / @item.RequiredInformationCount
                            </strong>
                        </div>
                    </div>

                    <div class="catalog-readiness-card__issues">
                        @if (item.Issues.Count == 0)
                        {
                            <span class="catalog-readiness-issue catalog-readiness-issue--ready">
                                Không phát hiện vấn đề cần xử lý
                            </span>
                        }
                        else
                        {
                            @foreach (var issue in item.Issues)
                            {
                                <span class="catalog-readiness-issue">@issue</span>
                            }
                        }
                    </div>

                    <footer>
                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Edit"
                           asp-route-id="@item.ProductId"
                           class="button button--secondary button--small">
                            Nội dung và hình ảnh
                        </a>
                        <a asp-area="Admin"
                           asp-controller="ProductOptions"
                           asp-action="Configure"
                           asp-route-productId="@item.ProductId"
                           class="button button--secondary button--small">
                            Lựa chọn mua và mã hàng
                        </a>
                        <a asp-area="Admin"
                           asp-controller="ProductInformation"
                           asp-action="EditProduct"
                           asp-route-productId="@item.ProductId"
                           class="button button--secondary button--small">
                            Thông tin ngành hàng
                        </a>
                        <a asp-area=""
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-slug="@item.ProductSlug"
                           target="_blank"
                           rel="noopener"
                           class="button button--secondary button--small">
                            Xem trang bán
                        </a>

                        @if (item.ProductIsActive)
                        {
                            <form asp-area="Admin"
                                  asp-controller="CatalogPublishing"
                                  asp-action="Hide"
                                  asp-route-productId="@item.ProductId"
                                  method="post">
                                <input type="hidden" name="Query" value="@Model.Query" />
                                <input type="hidden" name="Status" value="@Model.Status" />
                                <input type="hidden" name="Page" value="@Model.Page" />
                                <button type="submit"
                                        class="button button--secondary button--small">
                                    Ẩn sản phẩm
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Admin"
                                  asp-controller="CatalogPublishing"
                                  asp-action="Publish"
                                  asp-route-productId="@item.ProductId"
                                  method="post">
                                <input type="hidden" name="Query" value="@Model.Query" />
                                <input type="hidden" name="Status" value="@Model.Status" />
                                <input type="hidden" name="Page" value="@Model.Page" />
                                <button type="submit"
                                        class="button button--primary button--small">
                                    Kiểm tra và hiển thị
                                </button>
                            </form>
                        }
                    </footer>
                </article>
            }
        }
    </section>

    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pagination" aria-label="Phân trang">
            <a asp-action="Index"
               asp-route-query="@Model.Query"
               asp-route-status="@Model.Status"
               asp-route-page="@(Model.Page - 1)"
               class="button button--secondary @(Model.Page <= 1 ? "disabled" : null)">
                Trang trước
            </a>
            <span>Trang @Model.Page / @Model.TotalPages</span>
            <a asp-action="Index"
               asp-route-query="@Model.Query"
               asp-route-status="@Model.Status"
               asp-route-page="@(Model.Page + 1)"
               class="button button--secondary @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                Trang sau
            </a>
        </nav>
    }
</section>


@section Scripts {
    <script src="~/js/pages/admin/catalog-readiness.js"
            asp-append-version="true"></script>
}
