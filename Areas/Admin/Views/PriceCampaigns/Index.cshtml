@using WebApplication2.Models.Enums
@model WebApplication2.Areas.Admin.ViewModels.PriceCampaigns.PriceCampaignIndexPageViewModel
@{
    ViewData["Title"] = "Lịch áp dụng giá";
    var runningCount = Model.Items.Count(item => item.Status == PriceCampaignStatus.Active);
    var scheduledCount = Model.Items.Count(item =>
        item.Status is PriceCampaignStatus.Scheduled or PriceCampaignStatus.Confirmed);
    var terminalCount = Model.Items.Count(item =>
        item.Status is PriceCampaignStatus.Completed
            or PriceCampaignStatus.Cancelled
            or PriceCampaignStatus.Superseded);
}

<section class="admin-page" data-price-campaign-index>
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Điều hành giá bán theo thời gian</p>
            <h2>Lịch áp dụng giá cho từng mã hàng</h2>
            <p class="admin-page-lead">
                Lập lịch giá hiệu lực, xử lý chồng lấn và phục hồi giá cũ theo SKU.
                Khu vực này không quản lý mã giảm giá, ưu đãi tại giỏ hàng hoặc chương trình bán nhanh theo khung giờ.
            </p>
        </div>
        <a asp-action="Create" class="button button--primary">Tạo lịch giá</a>
    </header>

    <div class="pricing-taxonomy-note">
        <strong>Phân loại nghiệp vụ:</strong>
        Lịch giá thay đổi giá hiển thị của SKU theo thời gian.
        Khuyến mãi áp điều kiện giảm tại giỏ hàng hoặc mã giảm giá.
        Chương trình bán nhanh theo khung giờ cần hạn mức hàng, giới hạn mua và cơ chế chống bán vượt.
    </div>

    <section class="admin-metric-grid admin-metric-grid--four" aria-label="Tổng quan lịch giá">
        <article class="admin-metric-card">
            <div>
                <span class="admin-metric-card__label">Tổng lịch giá</span>
                <strong class="admin-metric-card__value">@Model.Items.Count</strong>
            </div>
        </article>
        <article class="admin-metric-card admin-metric-card--success">
            <div>
                <span class="admin-metric-card__label">Đang hiệu lực</span>
                <strong class="admin-metric-card__value">@runningCount</strong>
            </div>
        </article>
        <article class="admin-metric-card admin-metric-card--info">
            <div>
                <span class="admin-metric-card__label">Đã lên lịch</span>
                <strong class="admin-metric-card__value">@scheduledCount</strong>
            </div>
        </article>
        <article class="admin-metric-card">
            <div>
                <span class="admin-metric-card__label">Đã kết thúc</span>
                <strong class="admin-metric-card__value">@terminalCount</strong>
            </div>
        </article>
    </section>

    <div class="page-feedback"
         data-page-feedback
         role="status"
         aria-live="polite"></div>

    <section class="admin-panel">
        <header class="admin-panel__header">
            <div>
                <p class="admin-page-kicker">Vòng đời giá</p>
                <h3>Danh sách lịch áp dụng</h3>
                <p>Mỗi lịch giá phải có nguồn, thời gian hiệu lực, chính sách chồng lấn và lịch sử kiểm toán.</p>
            </div>
        </header>

        <div class="admin-table-wrap">
            <table class="admin-data-table campaign-table">
                <thead>
                    <tr>
                        <th>Lịch giá</th>
                        <th>Thời gian hiệu lực</th>
                        <th>Xử lý chồng lấn</th>
                        <th class="u-text-center">Mã hàng</th>
                        <th>Trạng thái</th>
                        <th class="u-text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-state admin-empty-state--compact">
                                    <div>
                                        <strong>Chưa có lịch giá</strong>
                                        <span>Tạo lịch đầu tiên để quản lý giá hiệu lực theo SKU.</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var statusText = item.Status switch
                            {
                                PriceCampaignStatus.Draft => "Bản nháp",
                                PriceCampaignStatus.Confirmed => "Đã xác nhận",
                                PriceCampaignStatus.Scheduled => "Đã lên lịch",
                                PriceCampaignStatus.Active => "Đang hiệu lực",
                                PriceCampaignStatus.Completed => "Đã kết thúc",
                                PriceCampaignStatus.Cancelled => "Đã hủy",
                                PriceCampaignStatus.Superseded => "Đã thay thế",
                                _ => item.Status.ToString()
                            };
                            var policyText = item.ConflictPolicy switch
                            {
                                PriceConflictPolicy.ReplaceFromStart => "Thay từ thời điểm bắt đầu",
                                PriceConflictPolicy.SupersedeNow => "Thay thế ngay",
                                _ => "Từ chối chồng lấn"
                            };
                            var statusClass = item.Status.ToString().ToLowerInvariant();
                            var policyClass = item.ConflictPolicy.ToString().ToLowerInvariant();

                            <tr data-campaign-row
                                data-campaign-id="@item.Id"
                                data-campaign-code="@item.Code"
                                data-campaign-name="@item.Name"
                                data-campaign-status="@item.Status"
                                data-row-version="@item.RowVersion">
                                <td>
                                    <span class="admin-cell-primary">@item.Name</span>
                                    <span class="admin-cell-secondary">@item.Code · @item.SourceType · @item.CreatedBy</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span class="admin-cell-secondary">@item.Description</span>
                                    }
                                </td>
                                <td>
                                    <time datetime="@item.StartDateUtc.ToString("O")" data-local-datetime>
                                        @item.StartDateUtc.ToString("dd/MM/yyyy HH:mm") UTC
                                    </time>
                                    <span class="time-separator">→</span>
                                    @if (item.EndDateUtc.HasValue)
                                    {
                                        <time datetime="@item.EndDateUtc.Value.ToString("O")" data-local-datetime>
                                            @item.EndDateUtc.Value.ToString("dd/MM/yyyy HH:mm") UTC
                                        </time>
                                    }
                                    else
                                    {
                                        <span>Không thời hạn</span>
                                    }
                                </td>
                                <td>
                                    <span class="policy-badge policy-badge--@policyClass">@policyText</span>
                                </td>
                                <td class="u-text-center">
                                    <span class="count-badge">@item.VariantCount</span>
                                </td>
                                <td>
                                    <span class="status-badge status-badge--@statusClass">@statusText</span>
                                    @if (item.SupersededByCampaignId.HasValue)
                                    {
                                        <span class="admin-cell-secondary">Thay bởi #@item.SupersededByCampaignId</span>
                                    }
                                </td>
                                <td class="u-text-end">
                                    <div class="table-actions">
                                        <button type="button"
                                                class="button button--secondary button--small"
                                                data-view-timeline>
                                            Chi tiết
                                        </button>

                                        @if (item.Status == PriceCampaignStatus.Draft)
                                        {
                                            <a asp-action="Create"
                                               asp-route-id="@item.Id"
                                               class="button button--secondary button--small">
                                                Chỉnh sửa
                                            </a>
                                        }

                                        @if (item.Status is PriceCampaignStatus.Confirmed or PriceCampaignStatus.Scheduled)
                                        {
                                            <button type="button"
                                                    class="button button--primary button--small"
                                                    data-apply-campaign>
                                                Áp dụng ngay
                                            </button>
                                        }

                                        @if (item.Status is PriceCampaignStatus.Draft
                                            or PriceCampaignStatus.Confirmed
                                            or PriceCampaignStatus.Scheduled
                                            or PriceCampaignStatus.Active)
                                        {
                                            <button type="button"
                                                    class="button button--danger button--small"
                                                    data-cancel-campaign>
                                                Dừng lịch giá
                                            </button>
                                        }

                                        @if (item.Status is PriceCampaignStatus.Active
                                            or PriceCampaignStatus.Completed
                                            or PriceCampaignStatus.Cancelled
                                            or PriceCampaignStatus.Superseded)
                                        {
                                            <button type="button"
                                                    class="button button--secondary button--small"
                                                    data-recover-campaign>
                                                Phục hồi giá trước
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <dialog class="pricing-dialog lifecycle-dialog" data-lifecycle-dialog>
        <form method="dialog" class="pricing-dialog__surface" data-lifecycle-form>
            <header class="pricing-dialog__header">
                <div>
                    <p class="admin-page-kicker">Thao tác vòng đời</p>
                    <h3 data-lifecycle-title>Xác nhận thao tác</h3>
                    <span data-lifecycle-description></span>
                </div>
                <button type="button"
                        class="pricing-dialog__close"
                        data-close-lifecycle>
                    Đóng
                </button>
            </header>
            <div class="pricing-dialog__body">
                <div class="lifecycle-summary" data-lifecycle-summary></div>
                <div class="form-field">
                    <label for="lifecycle-reason">Lý do thao tác</label>
                    <textarea id="lifecycle-reason"
                              maxlength="500"
                              rows="3"
                              data-lifecycle-reason
                              required></textarea>
                    <small>Lý do được ghi vào nhật ký giá để phục vụ kiểm toán.</small>
                </div>
                <div class="confirmation-warning" data-lifecycle-warning></div>
            </div>
            <footer class="pricing-dialog__footer">
                <button type="button"
                        class="button button--secondary"
                        data-close-lifecycle>
                    Quay lại
                </button>
                <button type="submit"
                        class="button button--danger"
                        data-lifecycle-confirm>
                    Xác nhận
                </button>
            </footer>
        </form>
    </dialog>

    <dialog class="pricing-dialog timeline-dialog" data-timeline-dialog>
        <div class="pricing-dialog__surface pricing-dialog__surface--wide">
            <header class="pricing-dialog__header">
                <div>
                    <p class="admin-page-kicker">Nhật ký kiểm toán</p>
                    <h3 data-timeline-title>Chi tiết lịch giá</h3>
                    <span data-timeline-subtitle></span>
                </div>
                <button type="button"
                        class="pricing-dialog__close"
                        data-close-timeline>
                    Đóng
                </button>
            </header>
            <div class="pricing-dialog__body" data-timeline-body>
                <div class="pricing-loading-state">Đang tải lịch sử...</div>
            </div>
            <footer class="pricing-dialog__footer">
                <button type="button"
                        class="button button--secondary"
                        data-close-timeline>
                    Đóng
                </button>
            </footer>
        </div>
    </dialog>
</section>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/price-campaigns.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/admin/price-campaigns.js"
            asp-append-version="true"></script>
}
