@using WebApplication2.Models.Enums
@using WebApplication2.Areas.Admin.ViewModels.Returns
@model WebApplication2.Areas.Admin.ViewModels.Returns.ReturnAdminIndexViewModel
@{
    ViewData["Title"] = "Hoàn trả và hoàn tiền";
    var waiting = Model.Items.Count(item =>
        item.Status is ReturnRequestStatus.Requested
            or ReturnRequestStatus.UnderReview);
    var moving = Model.Items.Count(item =>
        item.Status is ReturnRequestStatus.Approved
            or ReturnRequestStatus.AwaitingReturnShipment
            or ReturnRequestStatus.AwaitingPickup
            or ReturnRequestStatus.ReturnInTransit);
    var inspecting = Model.Items.Count(item =>
        item.Status is ReturnRequestStatus.ReceivedAtWarehouse
            or ReturnRequestStatus.Inspecting);
    var refunding = Model.Items.Count(item =>
        item.Status == ReturnRequestStatus.RefundPending);
    var completed = Model.Items.Count(item =>
        item.Status is ReturnRequestStatus.Refunded
            or ReturnRequestStatus.Closed);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/returns.css" asp-append-version="true" />
}

<section class="admin-page returns-page">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Vận hành sau bán</p>
            <h2>Hoàn trả và hoàn tiền</h2>
            <p class="admin-page-lead">
                Theo dõi yêu cầu từ lúc tiếp nhận, vận chuyển hàng về,
                kiểm tra sản phẩm đến khi chuyển khoản hoàn tất.
            </p>
        </div>
    </header>

    <section class="return-admin-metrics" aria-label="Tổng quan yêu cầu hoàn trả">
        <article><small>Chờ xem xét</small><strong>@waiting</strong></article>
        <article><small>Đang thu hồi hàng</small><strong>@moving</strong></article>
        <article><small>Đang kiểm tra</small><strong>@inspecting</strong></article>
        <article><small>Chờ hoàn tiền</small><strong>@refunding</strong></article>
        <article><small>Đã hoàn tất</small><strong>@completed</strong></article>
    </section>

    <section class="admin-filter-panel">
        <div class="admin-filter-panel__header">
            <div>
                <p class="admin-page-kicker">Bộ lọc</p>
                <h3>Tìm yêu cầu hoàn trả</h3>
            </div>
            <span>@Model.Items.Count kết quả</span>
        </div>

        <form method="get" class="admin-filter-grid admin-filter-grid--compact">
            <label class="admin-filter-field">
                <span>Tìm kiếm</span>
                <input name="search"
                       value="@Model.Search"
                       type="search"
                       placeholder="Mã yêu cầu, mã đơn hoặc khách hàng" />
            </label>
            <label class="admin-filter-field">
                <span>Trạng thái</span>
                <select name="status">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var status in Enum.GetValues<ReturnRequestStatus>())
                    {
                        if (Model.Status == status)
                        {
                            <option value="@status" selected>@ReturnAdminDisplay.StatusText(status)</option>
                        }
                        else
                        {
                            <option value="@status">@ReturnAdminDisplay.StatusText(status)</option>
                        }
                    }
                </select>
            </label>
            <div class="admin-filter-actions">
                <button type="submit" class="button button--primary">Áp dụng</button>
            </div>
            <div class="admin-filter-actions">
                <a asp-action="Index" class="button button--secondary">Xóa lọc</a>
            </div>
        </form>
    </section>

    <section class="admin-panel">
        <header class="admin-panel__header">
            <div>
                <p class="admin-page-kicker">Danh sách</p>
                <h3>Yêu cầu hoàn trả</h3>
            </div>
        </header>

        <div class="admin-table-wrap">
            <table class="admin-data-table return-admin-table">
                <thead>
                    <tr>
                        <th>Yêu cầu</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái</th>
                        <th>Số lượng</th>
                        <th class="text-end">Tiền hoàn</th>
                        <th>Ngày gửi</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty-state admin-empty-state--compact">
                                    <div>
                                        <strong>Không có yêu cầu phù hợp</strong>
                                        <span>Hãy thay đổi bộ lọc.</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Code</strong>
                                    <span class="admin-cell-secondary">Đơn @item.OrderCode</span>
                                </td>
                                <td>@item.CustomerName</td>
                                <td>
                                    <span class="return-admin-status return-admin-status--@item.Status.ToString().ToLowerInvariant()">
                                        @item.StatusText
                                    </span>
                                </td>
                                <td>
                                    @item.RequestedQuantity
                                    @if (item.ApprovedQuantity > 0)
                                    {
                                        <small>· chấp nhận @item.ApprovedQuantity</small>
                                    }
                                </td>
                                <td class="text-end"><strong>@item.RefundAmount.ToString("N0") ₫</strong></td>
                                <td>@item.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="button button--primary button--small">
                                        Xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
