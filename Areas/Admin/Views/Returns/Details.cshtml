@using WebApplication2.Models.Enums
@using WebApplication2.Services.Shipping.Internal
@model WebApplication2.Areas.Admin.ViewModels.Returns.ReturnAdminDetailsViewModel
@{
    ViewData["Title"] = $"Hoàn trả {Model.Code}";
    var inspectionIdempotencyKey = Guid.NewGuid().ToString("N");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/returns.css" asp-append-version="true" />
}

<section class="admin-page returns-page">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Yêu cầu @Model.Code · Đơn @Model.OrderCode</p>
            <h2>@Model.StatusText</h2>
            <p class="admin-page-lead">
                @Model.CustomerName · @Model.CustomerPhone · @Model.CustomerEmail
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a asp-area=""
               asp-controller="Orders"
               asp-action="Details"
               asp-route-publicToken="@Model.OrderPublicToken"
               target="_blank"
               rel="noopener noreferrer"
               class="button button--secondary">
                Xem phía khách hàng
            </a>
            <a asp-action="Index" class="button button--secondary">
                Danh sách hoàn trả
            </a>
        </div>
    </header>

    <ol class="return-admin-progress" aria-label="Tiến trình hoàn trả">
        @foreach (var step in Model.Progress)
        {
            <li class="@(step.IsComplete ? "is-complete" : null) @(step.IsCurrent ? "is-current" : null)">
                <span>
                    @if (step.IsComplete && !step.IsCurrent)
                    {
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                    }
                    else
                    {
                        @step.Position
                    }
                </span>
                <strong>@step.Title</strong>
            </li>
        }
    </ol>

    <div class="return-admin-layout">
        <main>
            <section class="admin-panel return-admin-overview">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Thông tin yêu cầu</p>
                        <h3>@Model.ReasonCode</h3>
                    </div>
                    <span class="return-admin-status return-admin-status--@Model.Status.ToString().ToLowerInvariant()">
                        @Model.StatusText
                    </span>
                </header>

                <dl class="return-admin-summary">
                    <div><dt>Khách hàng</dt><dd>@Model.CustomerName</dd></div>
                    <div><dt>Số điện thoại</dt><dd>@Model.CustomerPhone</dd></div>
                    <div class="is-wide"><dt>Địa chỉ</dt><dd>@Model.CustomerAddress</dd></div>
                    <div><dt>Gửi lúc</dt><dd>@Model.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                    <div><dt>Hạn bàn giao</dt><dd>@Model.ReturnWindowExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                    <div><dt>Tiền hoàn</dt><dd>@Model.RefundAmount.ToString("N0") ₫</dd></div>
                </dl>

                <div class="return-admin-reason">
                    <strong>Mô tả của khách hàng</strong>
                    <p>@Model.ReasonText</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ReviewNote))
                {
                    <div class="return-admin-note">
                        <strong>Phản hồi xử lý</strong>
                        <p>@Model.ReviewNote</p>
                    </div>
                }
            </section>

            <section class="admin-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Sản phẩm</p>
                        <h3>Toàn bộ đơn hàng</h3>
                    </div>
                    <span>@Model.Items.Sum(item => item.RequestedQuantity) sản phẩm</span>
                </header>

                <div class="return-admin-items">
                    @foreach (var item in Model.Items)
                    {
                        <article>
                            <div>
                                <strong>@item.ProductName</strong>
                                <span>@item.VariantDescription · @item.Sku</span>
                            </div>
                            <dl>
                                <div><dt>Yêu cầu</dt><dd>@item.RequestedQuantity</dd></div>
                                <div><dt>Chấp nhận</dt><dd>@item.ApprovedQuantity</dd></div>
                                <div><dt>Đã nhận</dt><dd>@item.ReceivedQuantity</dd></div>
                                <div><dt>Đạt</dt><dd>@item.AcceptedQuantity</dd></div>
                                <div><dt>Không đạt</dt><dd>@item.RejectedQuantity</dd></div>
                                <div><dt>Hoàn tiền</dt><dd>@item.RefundAmount.ToString("N0") ₫</dd></div>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(item.InspectionNote))
                            {
                                <p>@item.InspectionNote</p>
                            }
                        </article>
                    }
                </div>
            </section>

            @if (Model.Evidence.Count > 0)
            {
                <section class="admin-panel">
                    <header class="admin-panel__header">
                        <div>
                            <p class="admin-page-kicker">Hình ảnh</p>
                            <h3>Tình trạng do khách hàng cung cấp</h3>
                        </div>
                        <span>@Model.Evidence.Count ảnh</span>
                    </header>
                    <div class="return-admin-evidence">
                        @foreach (var evidence in Model.Evidence)
                        {
                            <a href="@evidence.Url"
                               target="_blank"
                               rel="noopener noreferrer">
                                <img src="@evidence.Url"
                                     alt="Hình ảnh hoàn trả"
                                     loading="lazy" />
                            </a>
                        }
                    </div>
                </section>
            }

            <section class="admin-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Lịch sử</p>
                        <h3>Cập nhật yêu cầu</h3>
                    </div>
                </header>
                @if (Model.History.Count == 0)
                {
                    <div class="admin-empty-state admin-empty-state--compact">
                        <div><strong>Chưa có cập nhật</strong></div>
                    </div>
                }
                else
                {
                    <div class="return-admin-history">
                        @foreach (var item in Model.History)
                        {
                            <article>
                                <span aria-hidden="true"></span>
                                <div>
                                    <small>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.ChangedBy</small>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p>@item.Description</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </main>

        <aside>
            <section class="admin-panel return-bank-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Tài khoản nhận tiền</p>
                        <h3>@Model.RefundBankName</h3>
                    </div>
                    <span class="vietqr-admin-badge">VietQR</span>
                </header>
                <dl>
                    <div><dt>Ngân hàng</dt><dd>@Model.RefundBankCode</dd></div>
                    <div><dt>Số tài khoản</dt><dd>@Model.RefundAccountNumber</dd></div>
                    <div><dt>Chủ tài khoản</dt><dd>@Model.RefundAccountName</dd></div>
                    <div><dt>Số tiền</dt><dd>@Model.RefundAmount.ToString("N0") ₫</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.VietQrUrl))
                {
                    <img src="@Model.VietQrUrl"
                         alt="Mã VietQR hoàn tiền cho @Model.Code"
                         class="return-vietqr-image" />
                }
            </section>

            <section class="admin-panel return-action-panel">
                <header class="admin-panel__header">
                    <div>
                        <p class="admin-page-kicker">Thao tác</p>
                        <h3>Bước xử lý hiện tại</h3>
                    </div>
                </header>

                @if (Model.Status == ReturnRequestStatus.Requested)
                {
                    <form asp-action="StartReview"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <label>
                            <span>Ghi chú tiếp nhận</span>
                            <textarea name="Note" rows="4" maxlength="1000"
                                      placeholder="Thông tin cần lưu ý khi xem xét yêu cầu..."></textarea>
                        </label>
                        <button type="submit" class="button button--primary">
                            Bắt đầu xem xét
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.UnderReview)
                {
                    <form asp-action="Decide"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form"
                          data-return-decision-form>
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        @for (var index = 0; index < Model.Items.Count; index++)
                        {
                            <input type="hidden"
                                   name="Items[@index].ReturnItemId"
                                   value="@Model.Items[index].Id" />
                            <input type="hidden"
                                   name="Items[@index].ApprovedQuantity"
                                   value="@Model.Items[index].RequestedQuantity" />
                        }
                        <label>
                            <span>Phản hồi cho khách hàng</span>
                            <textarea name="Note" rows="5" minlength="3" maxlength="500" required
                                      placeholder="Nêu rõ kết quả xem xét và hướng dẫn bước tiếp theo..."></textarea>
                        </label>
                        <div class="return-action-grid">
                            <button type="submit"
                                    name="Approve"
                                    value="true"
                                    class="button button--primary">
                                Chấp nhận toàn bộ đơn
                            </button>
                            <button type="submit"
                                    name="Approve"
                                    value="false"
                                    class="button button--danger">
                                Không chấp nhận
                            </button>
                        </div>
                    </form>
                }
                else if (Model.Status is ReturnRequestStatus.Approved
                         or ReturnRequestStatus.AwaitingReturnShipment)
                {
                    <form asp-action="UpdateShipping"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <input type="hidden" name="Action" value="PreparePickup" />
                        <label>
                            <span>Hướng dẫn bàn giao</span>
                            <textarea name="Note" rows="4" maxlength="500"
                                      placeholder="Ví dụ: Đóng gói đầy đủ sản phẩm và phụ kiện trước khi bàn giao."></textarea>
                        </label>
                        <button type="submit" class="button button--primary">
                            Sắp xếp tiếp nhận hàng hoàn
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.AwaitingPickup)
                {
                    <form asp-action="UpdateShipping"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <input type="hidden" name="Action" value="MarkInTransit" />
                        <label>
                            <span>Ghi chú</span>
                            <textarea name="Note" rows="4" maxlength="500"
                                      placeholder="Thông tin bàn giao hàng hoàn..."></textarea>
                        </label>
                        <button type="submit" class="button button--primary">
                            Xác nhận hàng đang được vận chuyển
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.ReturnInTransit)
                {
                    <form asp-action="UpdateShipping"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <input type="hidden" name="Action" value="MarkReceived" />
                        <label>
                            <span>Ghi chú tiếp nhận</span>
                            <textarea name="Note" rows="4" maxlength="500"
                                      placeholder="Tình trạng kiện hàng khi tiếp nhận..."></textarea>
                        </label>
                        <button type="submit" class="button button--primary">
                            Xác nhận đã nhận hàng hoàn
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.ReceivedAtWarehouse)
                {
                    <form asp-action="BeginInspection"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        @for (var index = 0; index < Model.Items.Count; index++)
                        {
                            <div class="return-action-line">
                                <strong>@Model.Items[index].ProductName</strong>
                                <input type="hidden"
                                       name="Items[@index].ReturnItemId"
                                       value="@Model.Items[index].Id" />
                                <label>
                                    <span>Số lượng tiếp nhận</span>
                                    <input type="number"
                                           name="Items[@index].ReceivedQuantity"
                                           min="0"
                                           max="@Model.Items[index].ApprovedQuantity"
                                           value="@Model.Items[index].ApprovedQuantity" />
                                </label>
                            </div>
                        }
                        <label>
                            <span>Ghi chú</span>
                            <textarea name="Note" rows="4" maxlength="1000"></textarea>
                        </label>
                        <button type="submit" class="button button--primary">
                            Bắt đầu kiểm tra sản phẩm
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.Inspecting)
                {
                    <form asp-action="CompleteInspection"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form return-inspection-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <input type="hidden" name="IdempotencyKey" value="@inspectionIdempotencyKey" />
                        @for (var index = 0; index < Model.Items.Count; index++)
                        {
                            var item = Model.Items[index];
                            <fieldset>
                                <legend>@item.ProductName</legend>
                                <input type="hidden"
                                       name="Items[@index].ReturnItemId"
                                       value="@item.Id" />
                                <div class="return-inspection-grid">
                                    <label>
                                        <span>Đạt</span>
                                        <input type="number" name="Items[@index].AcceptedQuantity"
                                               min="0" max="@item.ReceivedQuantity" value="@item.ReceivedQuantity" />
                                    </label>
                                    <label>
                                        <span>Không đạt</span>
                                        <input type="number" name="Items[@index].RejectedQuantity"
                                               min="0" max="@item.ReceivedQuantity" value="0" />
                                    </label>
                                    <label>
                                        <span>Nhập lại kho</span>
                                        <input type="number" name="Items[@index].RestockQuantity"
                                               min="0" max="@item.ReceivedQuantity" value="@item.ReceivedQuantity" />
                                    </label>
                                    <label>
                                        <span>Không nhập kho</span>
                                        <input type="number" name="Items[@index].WriteOffQuantity"
                                               min="0" max="@item.ReceivedQuantity" value="0" />
                                    </label>
                                    <label>
                                        <span>Tình trạng</span>
                                        <select name="Items[@index].ConditionCode">
                                            <option value="Restockable">Có thể bán lại</option>
                                            <option value="Damaged">Hư hỏng</option>
                                            <option value="MissingParts">Thiếu phụ kiện</option>
                                            <option value="WrongItem">Sai sản phẩm</option>
                                            <option value="Mixed">Tình trạng hỗn hợp</option>
                                            <option value="WriteOff">Không thể nhập kho</option>
                                        </select>
                                    </label>
                                    <label class="is-wide">
                                        <span>Ghi chú sản phẩm</span>
                                        <input type="text" name="Items[@index].Note" maxlength="500" />
                                    </label>
                                </div>
                            </fieldset>
                        }
                        <label>
                            <span>Kết luận kiểm tra</span>
                            <textarea name="Note" rows="5" minlength="3" maxlength="1000" required></textarea>
                        </label>
                        <button type="submit" class="button button--primary">
                            Hoàn tất kiểm tra
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.RefundPending)
                {
                    <form asp-action="CompleteRefund"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form"
                          data-refund-confirm-form>
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <div class="return-refund-confirmation">
                            <strong>@Model.RefundAmount.ToString("N0") ₫</strong>
                            <span>
                                Chuyển đến @Model.RefundAccountNumber · @Model.RefundBankName
                            </span>
                        </div>
                        <button type="submit" class="button button--primary">
                            Xác nhận đã chuyển khoản
                        </button>
                    </form>
                }
                else if (Model.Status == ReturnRequestStatus.Refunded)
                {
                    <form asp-action="Close"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="return-admin-form">
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <button type="submit" class="button button--primary">
                            Hoàn tất hồ sơ
                        </button>
                    </form>
                }
                else
                {
                    <div class="return-action-complete">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        <strong>@Model.StatusText</strong>
                        <span>Không có thao tác tiếp theo ở trạng thái hiện tại.</span>
                    </div>
                }
            </section>

            @if (Model.Shipment is not null)
            {
                <section class="admin-panel return-shipment-panel">
                    <header class="admin-panel__header">
                        <div>
                            <p class="admin-page-kicker">Hàng hoàn</p>
                            <h3>@(Model.Shipment.TrackingCode ?? "Chưa cấp mã tiếp nhận")</h3>
                        </div>
                    </header>
                    <dl>
                        <div><dt>Trạng thái</dt><dd>@Model.Shipment.StatusText</dd></div>
                        <div><dt>Bàn giao</dt><dd>@(Model.Shipment.CarrierHandoffAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa bàn giao")</dd></div>
                        <div><dt>Tiếp nhận</dt><dd>@(Model.Shipment.DeliveredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa tiếp nhận")</dd></div>
                    </dl>
                </section>
            }
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/admin/returns.js" asp-append-version="true"></script>
}
