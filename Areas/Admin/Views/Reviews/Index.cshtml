@model WebApplication2.Areas.Admin.ViewModels.Reviews.ReviewAdminIndexViewModel
@{
    ViewData["Title"] = "Đánh giá sản phẩm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/reviews.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/review-transparency.css" asp-append-version="true" />
}

<section class="admin-page review-admin-page">
    <header class="admin-page-header admin-page-header--hero">
        <div>
            <p class="admin-page-kicker">Tiếng nói người mua</p>
            <h2>Đánh giá sản phẩm</h2>
            <p class="admin-page-lead">
                Đánh giá đã mua hàng được hiển thị tự động.
                Admin có thể phản hồi công khai nhưng không thể duyệt, ẩn,
                từ chối hoặc sửa nội dung của khách hàng.
            </p>
        </div>
        <span class="review-transparency-badge">
            <i class="fa-solid fa-eye" aria-hidden="true"></i>
            Không kiểm duyệt trước
        </span>
    </header>

    <div class="review-transparency-notice">
        <i class="fa-solid fa-shield-heart" aria-hidden="true"></i>
        <div>
            <strong>Nguyên tắc minh bạch</strong>
            <span>
                Hệ thống chỉ xác minh giao dịch mua hàng và giữ nguyên nội dung,
                số sao, thời gian gửi cùng toàn bộ trao đổi công khai.
            </span>
        </div>
    </div>

    <form method="get" class="admin-filter-panel review-admin-filter review-admin-filter--transparent">
        <label class="admin-filter-field">
            <span>Tìm kiếm</span>
            <input type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Sản phẩm, mã đơn, khách hàng hoặc email" />
        </label>

        <label class="admin-filter-field">
            <span>Số sao</span>
            <select name="rating">
                <option value="">Tất cả</option>
                @for (var rating = 5; rating >= 1; rating--)
                {
                    <option value="@rating" selected="@(Model.Rating == rating)">
                        @rating sao
                    </option>
                }
            </select>
        </label>

        <button type="submit" class="button button--primary">Lọc</button>
        <a asp-action="Index" class="button button--secondary">Xóa lọc</a>
    </form>

    <section class="admin-panel">
        <div class="admin-table-wrap">
            <table class="admin-data-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Khách hàng</th>
                        <th>Đơn hàng</th>
                        <th>Số sao</th>
                        <th>Thảo luận</th>
                        <th>Ngày gửi</th>
                        <th class="u-text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty-state admin-empty-state--compact">
                                    <div>
                                        <strong>Không tìm thấy đánh giá</strong>
                                        <span>Hãy thay đổi bộ lọc.</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><strong>@item.ProductName</strong></td>
                                <td>@item.CustomerName</td>
                                <td>@item.OrderCode</td>
                                <td class="review-admin-stars">@item.Rating ★</td>
                                <td>
                                    @(item.ConversationCount == 0
                                        ? "Chưa có phản hồi"
                                        : $"{item.ConversationCount} phản hồi")
                                </td>
                                <td>@item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="u-text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="button button--primary button--small">
                                        Xem và phản hồi
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
